<div id="toast-container">
  <% if flash[:notice] %>
    <div class="toast toast-success" data-auto-dismiss="true">
      <div class="toast-icon">✓</div>
      <div class="toast-content">
        <p class="toast-message"><%= flash[:notice] %></p>
      </div>
      <button class="toast-close" onclick="closeToast(this)">×</button>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="toast toast-error" data-auto-dismiss="true">
      <div class="toast-icon">!</div>
      <div class="toast-content">
        <p class="toast-message"><%= flash[:alert] %></p>
      </div>
      <button class="toast-close" onclick="closeToast(this)">×</button>
    </div>
  <% end %>
</div>
