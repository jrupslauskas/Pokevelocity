<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <h1>Indigo Plateau Leaderboard</h1>
      <p>Who is the very best?</p>
    </header>

    <!-- Leaderboard -->
    <div class="leaderboard-container">
      <% @leaderboard_slots.each do |slot| %>
        <% trainers = slot[:trainer_data] %>
        <% has_current_user = trainers && trainers.any? { |t| t[:trainer].id == current_trainer.id } %>
        <div class="leaderboard-row <%= 'leaderboard-current-user' if has_current_user %> <%= 'leaderboard-empty-slot' unless trainers %>" data-slot-position="<%= slot[:position] %>">
          <div class="leaderboard-rank">
            <%
              # Map slot titles to their corresponding image filenames (lowercase)
              image_filename = slot[:title].downcase.gsub(' ', '')
              image_path = "trainerSprites/gymLeaders/#{image_filename}.png"
            %>
            <%= image_tag image_path, alt: slot[:title], class: "rank-icon" %>
          </div>

          <div class="leaderboard-tier-name">
            <%= slot[:tier_name] %>
          </div>

          <% if trainers && trainers.length > 1 %>
            <button class="carousel-arrow carousel-arrow-left" onclick="rotateCarousel(<%= slot[:position] %>, -1)">‹</button>
          <% end %>

          <div class="leaderboard-carousel-wrapper">
            <% if trainers %>
              <% trainers.each_with_index do |entry, index| %>
                <% profile_path = entry[:trainer].id == current_trainer.id ? pokedex_path : trainer_path(entry[:trainer]) %>
                <%= link_to profile_path, class: "leaderboard-trainer carousel-item #{'carousel-active' if index == 0}", data: { carousel_index: index } do %>
                  <% if entry[:trainer].icon_pokemon || entry[:trainer].icon_trainer_sprite %>
                    <div class="leaderboard-avatar">
                      <% if entry[:trainer].icon_pokemon %>
                        <% if entry[:trainer].icon_pokemon.image.attached? %>
                          <%= image_tag entry[:trainer].icon_pokemon.image, alt: entry[:trainer].icon_pokemon.name, class: "leaderboard-avatar-image" %>
                        <% else %>
                          <%= image_tag "pokemonSprites/#{entry[:trainer].icon_pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
                              alt: entry[:trainer].icon_pokemon.name,
                              class: "leaderboard-avatar-image",
                              style: "image-rendering: pixelated;" %>
                        <% end %>
                      <% elsif entry[:trainer].icon_trainer_sprite %>
                        <%= image_tag "trainerSprites/#{entry[:trainer].icon_trainer_sprite}.png",
                            alt: entry[:trainer].icon_trainer_sprite.split('/').last.titleize,
                            class: "leaderboard-avatar-image" %>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="leaderboard-avatar leaderboard-avatar-empty">
                      <span>👤</span>
                    </div>
                  <% end %>

                  <div class="leaderboard-trainer-info">
                    <span class="leaderboard-username">
                      <%= display_trainer_name(entry[:trainer]) %>
                      <% if entry[:trainer].id == current_trainer.id %>
                        <span class="you-badge">You</span>
                      <% end %>
                    </span>
                  </div>

                  <div class="leaderboard-stats">
                    <div class="leaderboard-stat">
                      <span class="stat-label">Pokédex</span>
                      <span class="stat-value"><%= entry[:pokemon_count] %> / 151</span>
                    </div>
                    <div class="leaderboard-stat leaderboard-stat-score">
                      <span class="stat-label">Difficulty Score</span>
                      <span class="stat-value stat-score"><%= entry[:difficulty_score] %>★</span>
                    </div>
                  </div>

                  <div class="party-tooltip">
                    <div class="party-tooltip-label">Party</div>
                    <% party = entry[:trainer].party_members %>
                    <% if party.any? %>
                      <div class="party-tooltip-pokemon-row">
                        <% party.each do |member| %>
                          <div class="party-tooltip-pokemon">
                            <%= image_tag "pokemonSprites/#{member.pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
                                alt: member.pokemon.name,
                                title: member.pokemon.name %>
                          </div>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="party-tooltip-empty">No party set</span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>

              <% if trainers.length > 1 %>
                <div class="carousel-counter">
                  <span class="carousel-counter-text">1 of <%= trainers.length %></span>
                </div>
              <% end %>
            <% else %>
              <div class="leaderboard-trainer carousel-item carousel-active">
                <div class="leaderboard-avatar leaderboard-avatar-empty">
                  <span>❓</span>
                </div>
                <div class="leaderboard-trainer-info">
                  <span class="leaderboard-username leaderboard-empty-text">Unclaimed</span>
                </div>

                <div class="leaderboard-stats">
                  <div class="leaderboard-stat">
                    <span class="stat-label stat-empty">—</span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <% if trainers && trainers.length > 1 %>
            <button class="carousel-arrow carousel-arrow-right" onclick="rotateCarousel(<%= slot[:position] %>, 1)">›</button>
          <% end %>
        </div>
      <% end %>
    </div>

    <script>
      function rotateCarousel(position, direction) {
        const row = document.querySelector(`[data-slot-position="${position}"]`);
        const items = row.querySelectorAll('.carousel-item');
        const counter = row.querySelector('.carousel-counter-text');

        let currentIndex = -1;
        items.forEach((item, index) => {
          if (item.classList.contains('carousel-active')) {
            currentIndex = index;
          }
        });

        if (currentIndex === -1) return;

        // Remove active class from current item
        items[currentIndex].classList.remove('carousel-active');

        // Calculate new index with wrapping
        let newIndex = currentIndex + direction;
        if (newIndex < 0) newIndex = items.length - 1;
        if (newIndex >= items.length) newIndex = 0;

        // Add active class to new item
        items[newIndex].classList.add('carousel-active');

        // Update counter
        if (counter) {
          counter.textContent = `${newIndex + 1} of ${items.length}`;
        }
      }
    </script>
  </main>
</div>
