<div>
  <div>
    <h1>Pokévelocity</h1>
    <p>Gotta Code 'Em All!</p>
  </div>

  <div>
    <h2>Trainer Login</h2>
    <p>Enter your credentials to continue your journey</p>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div>
        <%= label_tag :username, "Username" %>
        <%= text_field_tag :username, nil,
            placeholder: "Enter your trainer name",
            autofocus: true,
            required: true %>
      </div>

      <div>
        <%= label_tag :password, "Password" %>
        <%= password_field_tag :password, nil,
            placeholder: "Enter your password",
            required: true %>
      </div>

      <div>
        <%= submit_tag "Continue Adventure", class: "btn-primary" %>
      </div>
    <% end %>

    <div>
      <p>
        New trainer?
        <%= link_to "Create New Account", new_trainer_path %>
      </p>
    </div>
  </div>

  <div>
    <p>Complete tickets · Earn Pokéballs · Catch 'em all!</p>
  </div>
</div>
