<div>
  <div class="page-header" style="margin-bottom: 8px;">
    <div class="title-row">
      <div class="logo-placeholder"><%= image_tag "icons/pokeball.png", alt: "Pokeball", class: "logo-image" %></div>
      <h1 class="page-title">Pokévelocity</h1>
    </div>
  </div>

  <div style="text-align: center; margin-bottom: 32px;">
    <p class="tagline">Gotta Code 'Em All!</p>
    <p class="tagline">Complete tickets · Earn Pokéballs · Catch 'em all!</p>
  </div>

  <div class="card">
    <h2 class="card-title">Trainer Login</h2>
    <p class="card-subtitle">Enter your credentials to continue your journey</p>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div class="form-group">
        <%= label_tag :username, "Username", class: "form-label" %>
        <%= text_field_tag :username, nil,
            placeholder: "Enter your trainer name",
            autofocus: true,
            required: true,
            class: "form-input" %>
      </div>

      <div class="form-group">
        <%= label_tag :password, "Password", class: "form-label" %>
        <%= password_field_tag :password, nil,
            placeholder: "Enter your password",
            required: true,
            class: "form-input" %>
      </div>

      <div class="form-group-center">
        <%= submit_tag "Continue Adventure", class: "btn-primary" %>
      </div>
    <% end %>

    <p class="text-secondary">
      New trainer?
      <%= link_to "Create New Account", new_trainer_path, class: "link-secondary" %>
    </p>
  </div>

  <footer class="page-footer">
    <p class="footer-text">
      <%= link_to "View on GitHub", "https://github.com/jrupslauskas/Pokevelocity", target: "_blank", class: "footer-link" %>
    </p>
  </footer>
</div>
