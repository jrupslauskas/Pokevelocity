<div>
  <div class="page-header" style="margin-bottom: 8px;">
    <div class="title-row">
      <div class="logo-placeholder"><%= image_tag "icons/pokevelocity_logo.png", alt: "Pokevelocity Logo", class: "logo-image" %></div>
      <h1 class="page-title">Pokévelocity</h1>
    </div>
  </div>

  <div style="text-align: center; margin-bottom: 32px;">
    <p class="tagline">Gotta Code 'Em All!</p>
    <p class="tagline">Complete tickets · Earn Pokéballs · Catch 'em all!</p>
  </div>

  <div class="card">
    <h2 class="card-title">Trainer Login</h2>
    <p class="card-subtitle">Enter your credentials to continue your journey</p>

    <%= form_with url: login_path, method: :post, local: true, data: { turbo: false } do |f| %>
      <div class="form-group">
        <%= label_tag :username, "Username", class: "form-label" %>
        <%= text_field_tag :username, nil,
            placeholder: "Enter your trainer name",
            autofocus: true,
            required: true,
            class: "form-input" %>
      </div>

      <div class="form-group">
        <%= label_tag :password, "Password", class: "form-label" %>
        <div class="password-input-wrapper">
          <%= password_field_tag :password, nil,
              placeholder: "Enter your password",
              required: true,
              class: "form-input password-input",
              id: "password-field" %>
          <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('password-field', this)" aria-label="Toggle password visibility">
            <span class="password-toggle-icon">👁️</span>
          </button>
        </div>
      </div>

      <div class="form-group-center">
        <%= submit_tag "Continue Adventure", class: "btn-primary" %>
      </div>
    <% end %>

    <p class="text-secondary">
      New trainer?
      <%= link_to "Create New Account", new_trainer_path, class: "link-secondary" %>
    </p>
  </div>

  <footer class="page-footer">
    <p class="footer-text">
      <%= link_to "View on GitHub", "https://github.com/jrupslauskas/Pokevelocity", target: "_blank", class: "footer-link" %>
      <span style="margin: 0 8px; color: #6B5537;">•</span>
      <span style="color: #6B5537;">v<%= app_version %></span>
    </p>
  </footer>
</div>

<script>
  function togglePasswordVisibility(fieldId, button) {
    const passwordField = document.getElementById(fieldId);
    const icon = button.querySelector('.password-toggle-icon');

    if (passwordField.type === 'password') {
      passwordField.type = 'text';
      icon.textContent = '🙈';
    } else {
      passwordField.type = 'password';
      icon.textContent = '👁️';
    }
  }
</script>
