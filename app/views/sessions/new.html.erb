<div class="min-h-screen bg-gradient-to-b from-blue-400 via-blue-300 to-green-300 flex items-center justify-center p-4">
  <div class="max-w-md w-full">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-6xl font-bold text-white drop-shadow-lg mb-2">
        Pokévelocity
      </h1>
      <p class="text-xl text-white drop-shadow-md">Gotta Code 'Em All!</p>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-3xl shadow-2xl p-8 border-4 border-yellow-400">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-2">Trainer Login</h2>
        <p class="text-gray-600">Enter your credentials to continue your journey</p>
      </div>

      <%= form_with url: login_path, method: :post, local: true, class: "space-y-6" do |f| %>
        <div>
          <%= label_tag :username, "Username", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= text_field_tag :username, nil,
              placeholder: "Enter your username",
              class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors",
              autofocus: true,
              required: true %>
        </div>

        <div>
          <%= label_tag :password, "Password", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= password_field_tag :password, nil,
              placeholder: "Enter your password",
              class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors",
              required: true %>
        </div>

        <div>
          <%= submit_tag "Start Adventure",
              class: "w-full bg-gradient-to-r from-red-500 to-red-600 text-white font-bold py-3 px-6 rounded-lg hover:from-red-600 hover:to-red-700 transition-all transform hover:scale-105 shadow-lg cursor-pointer" %>
        </div>
      <% end %>

      <!-- New Trainer Link -->
      <div class="mt-6 text-center">
        <p class="text-gray-600">
          New trainer?
          <%= link_to "Create Account", new_trainer_path,
              class: "font-bold text-blue-600 hover:text-blue-800 hover:underline" %>
        </p>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-8">
      <p class="text-white text-sm drop-shadow-md">
        Complete tickets. Earn Pokéballs. Catch 'em all!
      </p>
    </div>
  </div>
</div>
