<div>
  <div class="page-header">
    <div class="logo-placeholder">⚡</div>
    <h1 class="page-title">Pokévelocity</h1>
    <p class="tagline">Gotta Code 'Em All!</p>
    <p class="tagline">Complete tickets · Earn Pokéballs · Catch 'em all!</p>
  </div>

  <div class="card">
    <h2>Trainer Login</h2>
    <p>Enter your credentials to continue your journey</p>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div class="form-group">
        <%= label_tag :username, "Username", class: "form-label" %>
        <%= text_field_tag :username, nil,
            placeholder: "Enter your trainer name",
            autofocus: true,
            required: true,
            class: "form-input" %>
      </div>

      <div class="form-group">
        <%= label_tag :password, "Password", class: "form-label" %>
        <%= password_field_tag :password, nil,
            placeholder: "Enter your password",
            required: true,
            class: "form-input" %>
      </div>

      <div class="form-group">
        <%= submit_tag "Continue Adventure", class: "btn-primary" %>
      </div>
    <% end %>

    <p class="text-secondary">
      New trainer?
      <%= link_to "Create New Account", new_trainer_path, class: "link-secondary" %>
    </p>
  </div>
</div>
