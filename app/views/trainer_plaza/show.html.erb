<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <div style="display: flex; align-items: center; gap: 16px;">
        <% if @trainer.icon_pokemon || @trainer.icon_trainer_sprite %>
          <div style="width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
            <% if @trainer.icon_pokemon %>
              <% if @trainer.icon_pokemon.image.attached? %>
                <%= image_tag @trainer.icon_pokemon.image, alt: @trainer.icon_pokemon.name, style: "width: 64px; height: 64px; object-fit: contain;" %>
              <% else %>
                <%= image_tag "pokemonSprites/#{@trainer.icon_pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
                    alt: @trainer.icon_pokemon.name,
                    style: "width: 64px; height: 64px; object-fit: contain; image-rendering: pixelated;" %>
              <% end %>
            <% elsif @trainer.icon_trainer_sprite %>
              <%= image_tag "trainerSprites/#{@trainer.icon_trainer_sprite}.png",
                  alt: @trainer.icon_trainer_sprite.split('/').last.titleize,
                  style: "width: 64px; height: 64px; object-fit: contain;" %>
            <% end %>
          </div>
        <% end %>
        <div>
          <h1>
            <%= display_trainer_name(@trainer) %>'s Pokédex
            <% if @trainer.id == current_trainer.id %>
              <span class="you-badge">You</span>
            <% end %>
          </h1>
          <p><%= @captured_pokemon.count %> Pokémon caught • <%= @trainer.difficulty_score %>★ Difficulty Score</p>
        </div>
      </div>
      <div style="margin-top: 16px;">
        <%= link_to "← Back to Trainer Plaza", trainer_plaza_path, class: "btn-secondary" %>
      </div>
    </header>

    <!-- Badges Section -->
    <div class="badges-section">
      <h2 class="badges-title">🏆 Gym Badges & Elite Four</h2>
      <div class="badges-container">
        <%
          # Badge mapping for gates 1-8 and Elite Four (gate 9)
          badge_map = {
            1 => { name: "Boulder Badge", sprite: "boulder_badge.png" },
            2 => { name: "Cascade Badge", sprite: "cascade_badge.png" },
            3 => { name: "Thunder Badge", sprite: "thunder_badge.png" },
            4 => { name: "Rainbow Badge", sprite: "rainbow_badge.png" },
            5 => { name: "Soul Badge", sprite: "soul_badge.png" },
            6 => { name: "Marsh Badge", sprite: "marsh_badge.png" },
            7 => { name: "Volcano Badge", sprite: "volcano_badge.png" },
            8 => { name: "Earth Badge", sprite: "earth_badge.png" },
            9 => { name: "Elite Four Trophy", sprite: "elite_four_trophy.png" }
          }

          # Get unlocked gates
          unlocked_gate_numbers = @trainer.gate_unlocks.includes(:gate).map { |gu| gu.gate.gate_number }
        %>

        <% (1..9).each do |gate_number| %>
          <div class="badge-slot <%= 'badge-earned' if unlocked_gate_numbers.include?(gate_number) %>" data-badge-number="<%= gate_number %>">
            <% if unlocked_gate_numbers.include?(gate_number) %>
              <%= image_tag "badges/#{badge_map[gate_number][:sprite]}",
                            alt: badge_map[gate_number][:name],
                            class: "badge-sprite",
                            title: badge_map[gate_number][:name] %>
            <% else %>
              <div class="badge-empty"></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Party Section -->
    <div class="party-section-dashboard">
      <h2 class="party-title-dashboard">Party</h2>
      <div class="party-container-dashboard">
        <%
          # Create a hash of position => party_member for easy lookup
          party_by_position = @party_members.index_by(&:position)
        %>

        <% (1..6).each do |position| %>
          <% party_member = party_by_position[position] %>
          <div class="party-slot-dashboard <%= 'party-filled-dashboard' if party_member %>">
            <% if party_member %>
              <div class="party-slot-inner-dashboard">
                <%= image_tag "pokemonSprites/#{party_member.pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
                              alt: party_member.pokemon.name,
                              class: "party-sprite-dashboard",
                              style: "image-rendering: pixelated;" %>
                <span class="party-pokemon-name-dashboard"><%= party_member.pokemon.name %></span>
              </div>
            <% else %>
              <div class="party-empty-dashboard">
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @captured_pokemon.any? %>
      <div class="pokedex-container">
        <div class="pokedex-grid">
          <% @captured_pokemon.each do |pokemon| %>
            <% capture = @trainer.captures.find_by(pokemon: pokemon) %>
            <div class="pokemon-card">
              <div class="pokemon-image-container">
                <% if pokemon.image.attached? %>
                  <%= image_tag pokemon.image, alt: pokemon.name, class: "pokemon-image" %>
                <% else %>
                  <%= image_tag "pokemonSprites/#{pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
                      alt: pokemon.name,
                      class: "pokemon-image",
                      style: "image-rendering: pixelated;" %>
                <% end %>
              </div>
              <p class="pokemon-number">#<%= pokemon.pokedex_number.to_s.rjust(3, '0') %></p>
              <h3 class="pokemon-name"><%= pokemon.name %></h3>
              <%= render "shared/difficulty_stars", pokemon: pokemon %>
              <div class="pokemon-meta">
                <% if capture.evolved %>
                  <span class="pokemon-capture-info">Evolved on <%= capture.captured_at.strftime("%m/%d/%y") %></span>
                <% else %>
                  <span class="pokemon-capture-info">Caught with a <%= capture.ball_type.humanize %> on <%= capture.captured_at.strftime("%m/%d/%y") %></span>
                <% end %>
                <% trainer_count = @pokemon_trainer_counts[pokemon.id] || 0 %>
                <span class="pokemon-trainer-count">Caught by <%= trainer_count %>/<%= @total_trainers %> <%= 'trainer'.pluralize(trainer_count) %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-icon">📖</div>
        <h3 class="empty-state-title">No Pokémon Yet!</h3>
        <p class="empty-state-description">
          <% if @trainer.id == current_trainer.id %>
            You haven't caught any Pokémon yet. Complete tickets to earn Pokéballs and start your collection!
          <% else %>
            <%= display_trainer_name(@trainer) %> hasn't caught any Pokémon yet.
          <% end %>
        </p>
        <% if @trainer.id == current_trainer.id %>
          <div style="display: flex; gap: 12px; justify-content: center; margin-top: 24px;">
            <%= link_to "Get Pokéballs", rewards_path, class: "btn-primary" %>
            <%= link_to "Go Catchin' →", catches_path, class: "btn-primary" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
