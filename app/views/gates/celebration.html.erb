<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <div class="celebration-container">
      <%
        # Badge mapping for gates 1-8 and Elite Four (gate 9)
        badge_map = {
          1 => { name: "Boulder Badge", sprite: "boulder_badge.png" },
          2 => { name: "Cascade Badge", sprite: "cascade_badge.png" },
          3 => { name: "Thunder Badge", sprite: "thunder_badge.png" },
          4 => { name: "Rainbow Badge", sprite: "rainbow_badge.png" },
          5 => { name: "Soul Badge", sprite: "soul_badge.png" },
          6 => { name: "Marsh Badge", sprite: "marsh_badge.png" },
          7 => { name: "Volcano Badge", sprite: "volcano_badge.png" },
          8 => { name: "Earth Badge", sprite: "earth_badge.png" },
          9 => { name: "Elite Four Trophy", sprite: "elite_four_trophy.png" }
        }
      %>
      <header class="page-header-authenticated">
        <h1>Congratulations!</h1>
        <p>You defeated <%= @gate.description.split(' - ').first %>!</p>
      </header>

      <div class="celebration-card">
        <div class="celebration-gym-leader">
          <% if @gate.sprite_type == "gym_leader" %>
            <%= image_tag "trainerSprites/gymLeaders/#{@gate.sprite_value}.png",
                          alt: @gate.description.split(' - ').first,
                          class: "celebration-sprite" %>
          <% else %>
            <div class="celebration-sprite celebration-emoji">
              <%= @gate.sprite_value %>
            </div>
          <% end %>
        </div>

        <div class="celebration-message">
          <% if badge_map[@gate.gate_number] %>
            <div class="celebration-badge">
              <%= image_tag "badges/#{badge_map[@gate.gate_number][:sprite]}",
                            alt: badge_map[@gate.gate_number][:name],
                            class: "celebration-badge-sprite",
                            title: badge_map[@gate.gate_number][:name] %>
            </div>
          <% end %>
          <h2 class="celebration-title">You earned the <%= @gate.name.split(' - ').last %>!</h2>
          <p class="celebration-text">
            Your difficulty score has reached <%= @trainer.difficulty_score %>★!
          </p>

          <% if @awarded_items.any? || @awarded_currency > 0 || @awarded_pokemon.any? %>
            <div class="celebration-items">
              <h3 class="celebration-items-title">Rewards:</h3>
              <ul class="celebration-items-list">
                <% @awarded_items.each do |item| %>
                  <li class="celebration-item">
                    <span class="celebration-item-icon">🎁</span>
                    <span class="celebration-item-name"><%= item[:name] %></span>
                  </li>
                <% end %>
                <% if @awarded_currency > 0 %>
                  <li class="celebration-item">
                    <span class="celebration-item-icon">💰</span>
                    <span class="celebration-item-name"><%= @awarded_currency %> Pokedollars</span>
                  </li>
                <% end %>
                <% @awarded_pokemon.each do |pokemon| %>
                  <li class="celebration-item celebration-pokemon">
                    <%= image_tag "pokemonSprites/#{pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
                                  alt: pokemon.name,
                                  class: "celebration-pokemon-sprite",
                                  title: pokemon.name %>
                    <span class="celebration-item-name"><%= pokemon.name %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="celebration-routes">
            <p class="celebration-routes-text">
              <span class="celebration-icon">🗺️</span>
              New routes unlocked!
            </p>
          </div>
        </div>

        <div class="celebration-actions">
          <%= button_to "Continue", catches_path, method: :get, class: "btn-primary btn-celebration" %>
        </div>
      </div>
    </div>
  </main>
</div>
