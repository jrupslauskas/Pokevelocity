<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <h1>Shop</h1>
      <p>Claim rewards and buy or sell items.</p>
      <div style="text-align: center; margin-top: 16px;">
        <span style="background: #FFF4E6; color: #2C5F2D; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 18px;">
          💰 Pokedollars: <%= @trainer.currency %>
        </span>
      </div>
    </header>

    <!-- Awards Counter Section -->

    <!-- Claim Reward Card -->
    <div class="card-dashboard" style="max-width: 800px; margin: 0 auto 32px;">
      <div class="card-dashboard-header">
        <span class="card-dashboard-icon">🎁</span>
        <h2 class="card-dashboard-title">Claim Your Reward</h2>
      </div>

      <p style="text-align: center; color: #6B5537; margin-bottom: 24px;">
        After completing a ticket, select the option below associated to your ticket's story points to receive a reward! Higher story points are more likely to grant better pokeballs!
      </p>

      <div class="story-points-grid">
        <%= form_with url: rewards_path, method: :post, local: true, class: "reward-form", data: { story_points: 1 } do |f| %>
          <%= hidden_field_tag :story_points, 1 %>
          <%= submit_tag "1 Point", class: "story-point-button" %>
        <% end %>

        <%= form_with url: rewards_path, method: :post, local: true, class: "reward-form", data: { story_points: 2 } do |f| %>
          <%= hidden_field_tag :story_points, 2 %>
          <%= submit_tag "2 Points", class: "story-point-button" %>
        <% end %>

        <%= form_with url: rewards_path, method: :post, local: true, class: "reward-form", data: { story_points: 3 } do |f| %>
          <%= hidden_field_tag :story_points, 3 %>
          <%= submit_tag "3 Points", class: "story-point-button" %>
        <% end %>

        <%= form_with url: rewards_path, method: :post, local: true, class: "reward-form", data: { story_points: 5 } do |f| %>
          <%= hidden_field_tag :story_points, 5 %>
          <%= submit_tag "5 Points", class: "story-point-button" %>
        <% end %>

        <%= form_with url: rewards_path, method: :post, local: true, class: "reward-form", data: { story_points: 8 } do |f| %>
          <%= hidden_field_tag :story_points, 8 %>
          <%= submit_tag "8 Points", class: "story-point-button" %>
        <% end %>

        <div class="story-point-other">
          <%= form_with url: rewards_path, method: :post, local: true, class: "reward-form-other", style: "display: flex; align-items: center; gap: 8px;" do |f| %>
            <%= number_field_tag :story_points, nil,
                min: 1,
                max: 100,
                placeholder: "Other",
                class: "story-point-input",
                id: "other-story-points" %>
            <%= submit_tag "Claim", class: "story-point-button-small" %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sales Counter Section -->
    <div class="card-dashboard" style="max-width: 800px; margin: 0 auto 32px;">
          <div class="card-dashboard-header">
            <span class="card-dashboard-icon">💳</span>
            <h2 class="card-dashboard-title">Buy and Sell</h2>
          </div>

    <div class="card-dashboard" style="max-width: 800px; margin: 0 auto;">
      <div style="display: flex; gap: 8px; margin-bottom: 24px; border-bottom: 2px solid #E8D5C4;">
        <button id="buyTab" class="shop-tab active" onclick="showTab('buy')">Buy</button>
        <button id="sellTab" class="shop-tab" onclick="showTab('sell')">Sell</button>
      </div>

      <!-- Buy Tab Content -->
      <div id="buyContent" class="tab-content">
        <p style="color: #6B5537; margin-bottom: 20px; text-align: center;">
          Purchase Poké Balls and evolution items!
        </p>
        <div style="display: grid; gap: 12px;">
          <%
            # Get pokeballs and evolution stones
            pokeballs = Item.where(item_type: 'pokeball').to_a.select { |item| item.buy_price.present? }
            evolution_stones = Item.where(item_type: 'evolution_stone').to_a.sort_by { |item| item.key == 'evolution_stone' ? 0 : 1 }

            # Sort pokeballs by buy_price
            pokeballs = pokeballs.sort_by { |item| item.buy_price }

            # Combine with pokeballs first
            all_items = pokeballs + evolution_stones
          %>
          <% all_items.each do |item| %>
            <div class="shop-item">
              <div style="display: flex; align-items: center; gap: 12px;">
                <%= image_tag "icons/#{item.sprite}", alt: item.name, class: "shop-item-icon" %>
                <div>
                  <div style="font-weight: 600; color: #2C5F2D;"><%= item.name %></div>
                  <div style="font-size: 14px; color: #6B5537;"><%= item.description %></div>
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-weight: 600; color: #2C5F2D;">💰 <%= item.buy_price %></span>
                <%= form_with url: buy_item_rewards_path, method: :post, local: true do |f| %>
                  <%= hidden_field_tag :item_key, item.key %>
                  <%= submit_tag "Buy", class: "btn-primary-small" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Sell Tab Content -->
      <div id="sellContent" class="tab-content" style="display: none;">
        <p style="color: #6B5537; margin-bottom: 20px; text-align: center;">
          Sell your items for Pokedollars!
        </p>
        <div style="display: grid; gap: 12px;">
          <% (Item.where(item_type: 'evolution_stone') + Item.where(item_type: 'pokeball')).each do |item| %>
            <% quantity = @trainer.item_quantity(item.key) %>
            <% if quantity > 0 %>
              <div class="shop-item">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <%= image_tag "icons/#{item.sprite}", alt: item.name, class: "shop-item-icon" %>
                  <div>
                    <div style="font-weight: 600; color: #2C5F2D;"><%= item.name %></div>
                    <div style="font-size: 14px; color: #6B5537;">Owned: <%= quantity %></div>
                  </div>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span style="font-weight: 600; color: #2C5F2D;">💰 <%= item.sell_price %></span>
                  <%= form_with url: sell_item_rewards_path, method: :post, local: true do |f| %>
                    <%= hidden_field_tag :item_key, item.key %>
                    <%= submit_tag "Sell", class: "btn-primary-small" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmationModal" class="modal" style="display: none;">
      <div class="modal-overlay"></div>
      <div class="modal-content">
        <h3 class="modal-title">Confirm Reward Claim</h3>
        <p class="modal-message" id="confirmationMessage">You completed a <span id="storyPointsValue">0</span> point story?</p>
        <div class="modal-actions">
          <button id="confirmYes" class="btn-primary">Yes</button>
          <button id="confirmNo" class="btn-secondary">No</button>
        </div>
      </div>
    </div>

    <script>
      function showTab(tab) {
        const buyTab = document.getElementById('buyTab');
        const sellTab = document.getElementById('sellTab');
        const buyContent = document.getElementById('buyContent');
        const sellContent = document.getElementById('sellContent');

        if (tab === 'buy') {
          buyTab.classList.add('active');
          sellTab.classList.remove('active');
          buyContent.style.display = 'block';
          sellContent.style.display = 'none';
        } else {
          sellTab.classList.add('active');
          buyTab.classList.remove('active');
          sellContent.style.display = 'block';
          buyContent.style.display = 'none';
        }
      }

      // Confirmation modal functionality
      document.addEventListener('turbo:load', function() {
        const modal = document.getElementById('confirmationModal');
        const confirmYes = document.getElementById('confirmYes');
        const confirmNo = document.getElementById('confirmNo');
        const storyPointsValue = document.getElementById('storyPointsValue');
        let pendingForm = null;

        // Handle fixed story point forms
        document.querySelectorAll('.reward-form').forEach(form => {
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            const points = this.dataset.storyPoints;
            storyPointsValue.textContent = points;
            pendingForm = this;
            modal.style.display = 'flex';
          });
        });

        // Handle "Other" story points form
        document.querySelectorAll('.reward-form-other').forEach(form => {
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            const points = document.getElementById('other-story-points').value;

            if (!points || points < 1) {
              alert('Please enter a valid story point value');
              return;
            }

            storyPointsValue.textContent = points;
            pendingForm = this;
            modal.style.display = 'flex';
          });
        });

        // Handle Yes button
        confirmYes.addEventListener('click', function() {
          if (pendingForm) {
            modal.style.display = 'none';
            // Submit the form natively (not via Turbo)
            const nativeForm = pendingForm.cloneNode(true);
            nativeForm.removeAttribute('data-turbo');
            document.body.appendChild(nativeForm);
            nativeForm.submit();
          }
        });

        // Handle No button
        confirmNo.addEventListener('click', function() {
          modal.style.display = 'none';
          pendingForm = null;
        });

        // Close modal on overlay click
        modal.querySelector('.modal-overlay').addEventListener('click', function() {
          modal.style.display = 'none';
          pendingForm = null;
        });
      });
    </script>
  </main>
</div>
