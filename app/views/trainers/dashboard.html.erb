<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <h1>Trainer Dashboard</h1>
      <p>Welcome back, <%= @trainer.username %>! Here's your progress overview.</p>
    </header>

    <div class="dashboard-grid">
      <!-- Pokéballs Inventory Card -->
      <div class="card-dashboard">
        <div class="card-dashboard-header">
          <span class="card-dashboard-icon">🎒</span>
          <h2 class="card-dashboard-title">Pokéball Inventory</h2>
        </div>

        <div class="inventory-item">
          <span class="inventory-item-label">
            <%= image_tag "icons/pokeball_shop.png", alt: "Pokeball", class: "inventory-icon" %>
            Pokéballs
          </span>
          <span class="inventory-item-count"><%= @trainer.pokeballs_count %></span>
        </div>

        <div class="inventory-item">
          <span class="inventory-item-label">
            <%= image_tag "icons/greatball.png", alt: "Great Ball", class: "inventory-icon" %>
            Great Balls
          </span>
          <span class="inventory-item-count"><%= @trainer.great_balls_count %></span>
        </div>

        <div class="inventory-item">
          <span class="inventory-item-label">
            <%= image_tag "icons/ultraball.jpg", alt: "Ultra Ball", class: "inventory-icon" %>
            Ultra Balls
          </span>
          <span class="inventory-item-count"><%= @trainer.ultra_balls_count %></span>
        </div>

        <div class="inventory-item">
          <span class="inventory-item-label">
            <%= image_tag "icons/masterball.png", alt: "Master Ball", class: "inventory-icon" %>
            Master Balls
          </span>
          <span class="inventory-item-count"><%= @trainer.master_balls_count %></span>
        </div>

        <div class="inventory-total">
          <span class="inventory-total-label">Total Pokéballs</span>
          <span class="inventory-total-count"><%= @trainer.total_pokeballs %></span>
        </div>
      </div>

      <!-- Pokédex Overview Card -->
      <div class="card-dashboard">
        <div class="card-dashboard-header">
          <span class="card-dashboard-icon"><%= image_tag "icons/pokedex.png", alt: "Pokedex", class: "card-dashboard-icon-image" %></span>
          <h2 class="card-dashboard-title">Pokédex Progress</h2>
        </div>

        <div class="pokedex-stats">
          <p class="pokedex-count"><%= @trainer.captures.count %></p>
          <p class="pokedex-label">Pokémon Captured</p>

          <% completion = (@trainer.captures.count.to_f / 151 * 100).round(1) %>
          <div class="progress-bar">
            <div class="progress-bar-fill" style="width: <%= completion %>%;"></div>
          </div>

          <p class="progress-text"><%= @trainer.captures.count %> / 151 Pokémon (<%= completion %>%)</p>
        </div>
      </div>
    </div>
  </main>
</div>
