<div class="min-h-screen bg-gradient-to-b from-green-200 via-lime-100 to-emerald-200" style="background-color: #E8F5E8;">
  <!-- Header -->
  <%= render "trainers/header" %>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Welcome Message -->
    <div class="rounded-lg shadow-lg p-6 mb-8 border-4" style="background: linear-gradient(to bottom, #FFFACD, #F5F0E8); border-color: #8B6F47;">
      <h2 class="text-3xl font-bold mb-2" style="color: #2C5F2D;">
        Welcome, <%= @trainer.username %>!
      </h2>
      <p class="text-gray-700">Your trainer dashboard</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Pokéballs Card -->
      <div class="rounded-lg shadow-xl p-6 border-4" style="background: linear-gradient(to bottom, #FFF8DC, #F5F0E8); border-color: #A67C52;">
        <h3 class="text-2xl font-bold mb-4" style="color: #2C5F2D;">Your Pokéballs</h3>
        <div class="space-y-3">
          <div class="flex justify-between items-center p-3 rounded-lg border-2" style="background-color: #FFE8E8; border-color: #C97A7A;">
            <span class="font-semibold text-gray-800">Pokéballs</span>
            <span class="text-2xl font-bold text-red-700"><%= @trainer.pokeballs_count %></span>
          </div>
          <div class="flex justify-between items-center p-3 rounded-lg border-2" style="background-color: #E8F0FF; border-color: #7A9AC9;">
            <span class="font-semibold text-gray-800">Great Balls</span>
            <span class="text-2xl font-bold text-blue-700"><%= @trainer.great_balls_count %></span>
          </div>
          <div class="flex justify-between items-center p-3 rounded-lg border-2" style="background-color: #FFF9E8; border-color: #C9B77A;">
            <span class="font-semibold text-gray-800">Ultra Balls</span>
            <span class="text-2xl font-bold text-yellow-700"><%= @trainer.ultra_balls_count %></span>
          </div>
          <div class="flex justify-between items-center p-3 rounded-lg border-2" style="background-color: #F0E8FF; border-color: #9C7AC9;">
            <span class="font-semibold text-gray-800">Master Balls</span>
            <span class="text-2xl font-bold text-purple-700"><%= @trainer.master_balls_count %></span>
          </div>
        </div>
        <div class="mt-4 pt-4 border-t-2" style="border-color: #A67C52;">
          <div class="flex justify-between items-center">
            <span class="font-bold" style="color: #2C5F2D;">Total</span>
            <span class="text-3xl font-bold" style="color: #5FA777;"><%= @trainer.total_pokeballs %></span>
          </div>
        </div>
      </div>

      <!-- Pokédex Card -->
      <div class="rounded-lg shadow-xl p-6 border-4" style="background: linear-gradient(to bottom, #FFF8DC, #F5F0E8); border-color: #A67C52;">
        <h3 class="text-2xl font-bold mb-4" style="color: #2C5F2D;">Your Pokédex</h3>
        <div class="text-center py-8">
          <p class="text-6xl font-bold mb-2" style="color: #2C5F2D;"><%= @trainer.captures.count %></p>
          <p class="text-gray-700 font-semibold">Pokémon Captured</p>
          <div class="mt-4 text-sm text-gray-600">
            <%= @trainer.captures.count %> / 151 Original Pokémon
          </div>
          <div class="mt-4">
            <div class="w-full rounded-full h-4 border-2" style="background-color: #E8DCC8; border-color: #A67C52;">
              <% completion = (@trainer.captures.count.to_f / 151 * 100).round(1) %>
              <div class="h-full rounded-full" style="width: <%= completion %>%; background: linear-gradient(to right, #7AC74C, #5FA777);"></div>
            </div>
            <p class="text-sm text-gray-700 mt-2 font-semibold"><%= completion %>% Complete</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <%= link_to pokedex_path, class: "rounded-lg shadow-xl p-8 border-4 transition-all hover:scale-105 text-center", style: "background: linear-gradient(to bottom, #FFE8E8, #FFF0DC); border-color: #C97A7A;" do %>
        <div class="text-6xl mb-3">📖</div>
        <h3 class="text-2xl font-bold mb-2" style="color: #2C5F2D;">Pokédex</h3>
        <p class="text-gray-700">View your captured Pokémon</p>
        <div class="mt-4">
          <span class="text-3xl font-bold text-red-700"><%= @trainer.captures.count %></span>
          <span class="text-gray-600 text-sm"> / 151</span>
        </div>
      <% end %>

      <%= link_to catch_pokemon_path, class: "rounded-lg shadow-xl p-8 border-4 transition-all hover:scale-105 text-center", style: "background: linear-gradient(to bottom, #E8FFDC, #F0FFE8); border-color: #7AC74C;" do %>
        <div class="text-6xl mb-3">🎣</div>
        <h3 class="text-2xl font-bold mb-2" style="color: #2C5F2D;">Catch</h3>
        <p class="text-gray-700">Catch a Pokémon</p>
        <div class="mt-4">
          <span class="text-lg font-bold" style="color: #5FA777;">Use Pokéballs!</span>
        </div>
      <% end %>

      <%= link_to bag_path, class: "rounded-lg shadow-xl p-8 border-4 transition-all hover:scale-105 text-center", style: "background: linear-gradient(to bottom, #FFF9E8, #FFFDDC); border-color: #C9B77A;" do %>
        <div class="text-6xl mb-3">🎒</div>
        <h3 class="text-2xl font-bold mb-2" style="color: #2C5F2D;">Bag</h3>
        <p class="text-gray-700">Check your Pokéball inventory</p>
        <div class="mt-4">
          <span class="text-3xl font-bold" style="color: #7AC74C;"><%= @trainer.total_pokeballs %></span>
          <span class="text-gray-600 text-sm"> Pokéballs</span>
        </div>
      <% end %>

      <%= link_to rewards_path, class: "rounded-lg shadow-xl p-8 border-4 transition-all hover:scale-105 text-center", style: "background: linear-gradient(to bottom, #FFFACD, #F5F0E8); border-color: #D4AF37;" do %>
        <div class="text-6xl mb-3">🎁</div>
        <h3 class="text-2xl font-bold mb-2" style="color: #2C5F2D;">Redeem</h3>
        <p class="text-gray-700">Claim rewards for completed tickets</p>
        <div class="mt-4">
          <span class="text-lg font-bold" style="color: #D4AF37;">Earn Pokéballs!</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
