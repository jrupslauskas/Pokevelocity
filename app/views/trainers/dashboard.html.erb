<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <h1>Trainer Dashboard</h1>
      <p>Welcome back, <%= @trainer.username %>! Here's your progress overview.</p>
    </header>

    <!-- Elite Trainer Offer (only show if all 151 caught) -->
    <% if @trainer.captures.select(:pokemon_id).distinct.count >= 151 %>
      <div class="card-dashboard" style="max-width: 500px; margin: 0 auto 24px; background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); border: 3px solid #DAA520;">
        <div class="card-dashboard-header" style="border-bottom: 2px solid #DAA520;">
          <span class="card-dashboard-icon">⭐</span>
          <h2 class="card-dashboard-title" style="color: #2C5F2D;">Pokédex Complete!</h2>
        </div>
        <div style="padding: 12px 16px; text-align: center;">
          <p style="color: #2C5F2D; font-size: 15px; margin-bottom: 8px; font-weight: 600;">
            Congratulations! You've caught all 151 Pokémon!
          </p>
          <p style="color: #2C5F2D; font-size: 13px; margin-bottom: 12px;">
            Ready to start a new adventure as an Elite Trainer?
          </p>
          <%= link_to "Become Elite Trainer!", elite_trainer_congratulations_path, class: "btn-primary" %>
        </div>
      </div>
    <% end %>

    <!-- Badges Section -->
    <div class="badges-section">
      <h2 class="badges-title">🏆 Gym Badges & Elite Four</h2>
      <div class="badges-container">
        <%
          # Badge mapping for gates 1-8 and Elite Four (gate 9)
          badge_map = {
            1 => { name: "Boulder Badge", sprite: "boulder_badge.png" },
            2 => { name: "Cascade Badge", sprite: "cascade_badge.png" },
            3 => { name: "Thunder Badge", sprite: "thunder_badge.png" },
            4 => { name: "Rainbow Badge", sprite: "rainbow_badge.png" },
            5 => { name: "Soul Badge", sprite: "soul_badge.png" },
            6 => { name: "Marsh Badge", sprite: "marsh_badge.png" },
            7 => { name: "Volcano Badge", sprite: "volcano_badge.png" },
            8 => { name: "Earth Badge", sprite: "earth_badge.png" },
            9 => { name: "Elite Four Trophy", sprite: "elite_four_trophy.png" }
          }

          # Get unlocked gates
          unlocked_gate_numbers = @trainer.gate_unlocks.includes(:gate).map { |gu| gu.gate.gate_number }
        %>

        <% (1..9).each do |gate_number| %>
          <div class="badge-slot <%= 'badge-earned' if unlocked_gate_numbers.include?(gate_number) %>" data-badge-number="<%= gate_number %>">
            <% if unlocked_gate_numbers.include?(gate_number) %>
              <%= image_tag "badges/#{badge_map[gate_number][:sprite]}",
                            alt: badge_map[gate_number][:name],
                            class: "badge-sprite",
                            title: badge_map[gate_number][:name] %>
            <% else %>
              <div class="badge-empty"></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="dashboard-grid">
      <!-- Inventory Card -->
      <div class="card-dashboard">
        <div class="card-dashboard-header" style="display: flex; justify-content: space-between; align-items: center;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <span class="card-dashboard-icon">🎒</span>
            <h2 class="card-dashboard-title">Inventory</h2>
          </div>
          <span class="currency-display">
            💰 Pokedollars: <%= @trainer.currency %>
          </span>
        </div>

        <!-- Pokéballs Section -->
        <% if @pokeball_items.any? %>
          <h3 class="inventory-subsection-title">Pokéballs</h3>
          <% @pokeball_items.each do |item_data| %>
            <div class="inventory-item">
              <span class="inventory-item-label">
                <%= image_tag "icons/#{item_data[:item].sprite}", alt: item_data[:item].name, class: "inventory-icon" %>
                <%= item_data[:item].name %>
              </span>
              <div class="inventory-item-actions">
                <span class="inventory-item-count"><%= item_data[:quantity] %></span>
                <%= button_to discard_item_path(item_key: item_data[:item].key),
                              method: :delete,
                              class: "btn-discard-item discard-item-form",
                              data: {
                                item_name: item_data[:item].name,
                                item_key: item_data[:item].key
                              },
                              form: {
                                class: "discard-item-form",
                                data: {
                                  turbo: false,
                                  item_name: item_data[:item].name
                                }
                              } do %>
                  <%= image_tag "icons/trash_can.png", alt: "Discard", class: "discard-icon" %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>

        <!-- Evolution Items Section -->
        <% if @evolution_items.any? %>
          <h3 class="inventory-subsection-title">Evolution Items</h3>
          <% @evolution_items.each do |item_data| %>
            <div class="inventory-item">
              <span class="inventory-item-label">
                <%= image_tag "icons/#{item_data[:item].sprite}", alt: item_data[:item].name, class: "inventory-icon" %>
                <%= item_data[:item].name %>
              </span>
              <div class="inventory-item-actions">
                <span class="inventory-item-count"><%= item_data[:quantity] %></span>
                <%= button_to discard_item_path(item_key: item_data[:item].key),
                              method: :delete,
                              class: "btn-discard-item discard-item-form",
                              data: {
                                item_name: item_data[:item].name,
                                item_key: item_data[:item].key
                              },
                              form: {
                                class: "discard-item-form",
                                data: {
                                  turbo: false,
                                  item_name: item_data[:item].name
                                }
                              } do %>
                  <%= image_tag "icons/trash_can.png", alt: "Discard", class: "discard-icon" %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>

        <!-- Restoration Items Section -->
        <% if @restoration_items.any? %>
          <h3 class="inventory-subsection-title">Restoration Items</h3>
          <% @restoration_items.each do |item_data| %>
            <div class="inventory-item">
              <span class="inventory-item-label">
                <%= image_tag "icons/#{item_data[:item].sprite}", alt: item_data[:item].name, class: "inventory-icon" %>
                <%= item_data[:item].name %>
              </span>
              <div class="inventory-item-actions">
                <span class="inventory-item-count"><%= item_data[:quantity] %></span>
                <%= button_to discard_item_path(item_key: item_data[:item].key),
                              method: :delete,
                              class: "btn-discard-item discard-item-form",
                              data: {
                                item_name: item_data[:item].name,
                                item_key: item_data[:item].key
                              },
                              form: {
                                class: "discard-item-form",
                                data: {
                                  turbo: false,
                                  item_name: item_data[:item].name
                                }
                              } do %>
                  <%= image_tag "icons/trash_can.png", alt: "Discard", class: "discard-icon" %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>

        <!-- Adventure Items Section -->
        <% if @adventure_items.any? %>
          <h3 class="inventory-subsection-title">Adventure Items</h3>
          <% @adventure_items.each do |item_data| %>
            <div class="inventory-item">
              <span class="inventory-item-label">
                <%= image_tag "icons/#{item_data[:item].sprite}", alt: item_data[:item].name, class: "inventory-icon" %>
                <%= item_data[:item].name %>
              </span>
              <span class="inventory-item-count"><%= item_data[:quantity] %></span>
            </div>
          <% end %>
        <% end %>

        <!-- Empty Inventory Message -->
        <% if @pokeball_items.empty? && @evolution_items.empty? && @restoration_items.empty? && @adventure_items.empty? %>
          <p class="inventory-empty">Your inventory is empty.</p>
        <% end %>
      </div>

      <!-- Pokédex Overview Card -->
      <div class="card-dashboard">
        <div class="card-dashboard-header">
          <span class="card-dashboard-icon"><%= image_tag "icons/pokedex.png", alt: "Pokedex", class: "card-dashboard-icon-image" %></span>
          <h2 class="card-dashboard-title">Pokédex Progress</h2>
        </div>

        <div class="pokedex-stats">
          <p class="pokedex-count"><%= @trainer.difficulty_score %>★</p>
          <p class="pokedex-label">Difficulty Score</p>

          <div style="border-bottom: 1px solid #E8DCC8; margin-top: 24px; margin-bottom: 16px;"></div>

          <p class="pokedex-count"><%= @trainer.captures.count %></p>
          <p class="pokedex-label">Pokémon Captured</p>

          <% completion = (@trainer.captures.count.to_f / 151 * 100).round(1) %>
          <div class="progress-bar">
            <div class="progress-bar-fill" style="width: <%= completion %>%;"></div>
          </div>

          <p class="progress-text"><%= @trainer.captures.count %> / 151 Pokémon (<%= completion %>%)</p>
        </div>
      </div>

      <!-- News Feed Card -->
      <div class="card-dashboard news-feed-card">
        <div class="card-dashboard-header">
          <span class="card-dashboard-icon">📰</span>
          <h2 class="card-dashboard-title">News Feed</h2>
        </div>

        <div class="news-feed">
          <% if @news_feed.any? %>
            <% @news_feed.each do |event| %>
              <% is_current_trainer = event[:trainer].id == @trainer.id %>
              <% link_path = is_current_trainer ? pokedex_path : trainer_path(event[:trainer]) %>
              <%= link_to link_path, class: "news-item-link" do %>
                <div class="news-item" data-event-type="<%= event[:type] %>">
                  <div class="news-item-content">
                    <%= image_tag "pokemonSprites/#{event[:pokemon].pokedex_number.to_s.rjust(3, '0')}.png",
                                  alt: event[:pokemon].name,
                                  class: "news-pokemon-sprite" %>
                    <div class="news-item-text">
                      <span class="news-trainer"><%= is_current_trainer ? "You" : event[:trainer].username %></span>
                      <% if event[:type] == 'caught' %>
                        caught a <span class="news-pokemon"><%= event[:pokemon].name %></span>!
                      <% else %>
                        evolved <span class="news-pokemon"><%= event[:pokemon].name %></span>!
                      <% end %>
                      <span class="news-timestamp"><%= time_ago_in_words(event[:timestamp]) %> ago</span>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <p class="news-feed-empty">No recent activity.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Discard Item Confirmation Modal -->
    <div id="discardItemModal" class="modal" style="display: none;">
      <div class="modal-overlay"></div>
      <div class="modal-content">
        <h3 class="modal-title">Confirm Discard</h3>
        <p class="modal-message" id="discardMessage">Are you sure you want to throw away 1 <span id="itemNameValue">Item</span>?</p>
        <div class="modal-actions">
          <button id="discardYes" class="btn-primary">Yes</button>
          <button id="discardNo" class="btn-secondary">No</button>
        </div>
      </div>
    </div>

    <script>
      // Discard item confirmation modal functionality
      document.addEventListener('turbo:load', function() {
        const modal = document.getElementById('discardItemModal');
        const discardYes = document.getElementById('discardYes');
        const discardNo = document.getElementById('discardNo');
        const itemNameValue = document.getElementById('itemNameValue');
        let pendingForm = null;

        // Handle discard item forms
        document.querySelectorAll('.discard-item-form').forEach(form => {
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            const itemName = this.dataset.itemName;
            itemNameValue.textContent = itemName;
            pendingForm = this;
            modal.style.display = 'flex';
          });
        });

        // Handle Yes button
        discardYes.addEventListener('click', function() {
          if (pendingForm) {
            modal.style.display = 'none';
            // Submit the form natively (not via Turbo)
            const nativeForm = pendingForm.cloneNode(true);
            nativeForm.removeAttribute('data-turbo');
            document.body.appendChild(nativeForm);
            nativeForm.submit();
          }
        });

        // Handle No button
        discardNo.addEventListener('click', function() {
          modal.style.display = 'none';
          pendingForm = null;
        });

        // Close modal on overlay click
        modal.querySelector('.modal-overlay').addEventListener('click', function() {
          modal.style.display = 'none';
          pendingForm = null;
        });
      });
    </script>
  </main>
</div>
