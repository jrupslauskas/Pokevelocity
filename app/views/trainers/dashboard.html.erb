<div>
  <%= render "trainers/header" %>

  <div>
    <div>
      <div>
        <span>👋</span>
      </div>
      <h2>Welcome, <%= @trainer.username %>!</h2>
      <p>Your trainer dashboard</p>
    </div>

    <div>
      <div>
        <h3>Your Pokéballs</h3>
        <div>
          <div>
            <span>Pokéballs</span>
            <span><%= @trainer.pokeballs_count %></span>
          </div>
          <div>
            <span>Great Balls</span>
            <span><%= @trainer.great_balls_count %></span>
          </div>
          <div>
            <span>Ultra Balls</span>
            <span><%= @trainer.ultra_balls_count %></span>
          </div>
          <div>
            <span>Master Balls</span>
            <span><%= @trainer.master_balls_count %></span>
          </div>
        </div>
        <div>
          <div>
            <span>Total</span>
            <span><%= @trainer.total_pokeballs %></span>
          </div>
        </div>
      </div>

      <div>
        <h3>Your Pokédex</h3>
        <div>
          <p><%= @trainer.captures.count %></p>
          <p>Pokémon Captured</p>
          <div>
            <%= @trainer.captures.count %> / 151 Original Pokémon
          </div>
          <div>
            <div>
              <% completion = (@trainer.captures.count.to_f / 151 * 100).round(1) %>
              <div></div>
            </div>
            <p><%= completion %>% Complete</p>
          </div>
        </div>
      </div>
    </div>

    <div>
      <%= link_to pokedex_path do %>
        <div>📖</div>
        <h3>Pokédex</h3>
        <p>View your captured Pokémon</p>
        <div>
          <span><%= @trainer.captures.count %></span>
          <span> / 151</span>
        </div>
      <% end %>

      <%= link_to catch_pokemon_path do %>
        <div>🎣</div>
        <h3>Catch</h3>
        <p>Catch a Pokémon</p>
        <div>
          <span>Use Pokéballs!</span>
        </div>
      <% end %>

      <%= link_to bag_path do %>
        <div>🎒</div>
        <h3>Bag</h3>
        <p>Check your Pokéball inventory</p>
        <div>
          <span><%= @trainer.total_pokeballs %></span>
          <span> Pokéballs</span>
        </div>
      <% end %>

      <%= link_to rewards_path do %>
        <div>🎁</div>
        <h3>Redeem</h3>
        <p>Claim rewards for completed tickets</p>
        <div>
          <span>Earn Pokéballs!</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
