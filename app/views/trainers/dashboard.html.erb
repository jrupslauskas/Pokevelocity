<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <h1>Trainer Dashboard</h1>
      <p>Welcome back, <%= @trainer.username %>! Here's your progress overview.</p>
    </header>

    <!-- Badges Section -->
    <div class="badges-section">
      <h2 class="badges-title">🏆 Gym Badges & Elite Four</h2>
      <div class="badges-container">
        <%
          # Badge mapping for gates 1-8 and Elite Four (gate 9)
          badge_map = {
            1 => { name: "Boulder Badge", sprite: "boulder_badge.png" },
            2 => { name: "Cascade Badge", sprite: "cascade_badge.png" },
            3 => { name: "Thunder Badge", sprite: "thunder_badge.png" },
            4 => { name: "Rainbow Badge", sprite: "rainbow_badge.png" },
            5 => { name: "Soul Badge", sprite: "soul_badge.png" },
            6 => { name: "Marsh Badge", sprite: "marsh_badge.png" },
            7 => { name: "Volcano Badge", sprite: "volcano_badge.png" },
            8 => { name: "Earth Badge", sprite: "earth_badge.png" },
            9 => { name: "Elite Four Trophy", sprite: "elite_four_trophy.png" }
          }

          # Get unlocked gates
          unlocked_gate_numbers = @trainer.gate_unlocks.includes(:gate).map { |gu| gu.gate.gate_number }
        %>

        <% (1..9).each do |gate_number| %>
          <div class="badge-slot <%= 'badge-earned' if unlocked_gate_numbers.include?(gate_number) %>" data-badge-number="<%= gate_number %>">
            <% if unlocked_gate_numbers.include?(gate_number) %>
              <%= image_tag "badges/#{badge_map[gate_number][:sprite]}",
                            alt: badge_map[gate_number][:name],
                            class: "badge-sprite",
                            title: badge_map[gate_number][:name] %>
            <% else %>
              <div class="badge-empty"></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="dashboard-grid">
      <!-- Inventory Card -->
      <div class="card-dashboard">
        <div class="card-dashboard-header">
          <span class="card-dashboard-icon">🎒</span>
          <h2 class="card-dashboard-title">Inventory</h2>
        </div>

        <!-- Pokéballs Section -->
        <% if @pokeball_items.any? %>
          <h3 class="inventory-subsection-title">Pokéballs</h3>
          <% @pokeball_items.each do |item_data| %>
            <div class="inventory-item">
              <span class="inventory-item-label">
                <%= image_tag "icons/#{item_data[:item].sprite}", alt: item_data[:item].name, class: "inventory-icon" %>
                <%= item_data[:item].name %>
              </span>
              <span class="inventory-item-count"><%= item_data[:quantity] %></span>
            </div>
          <% end %>
        <% end %>

        <!-- Evolution Items Section -->
        <% if @evolution_items.any? %>
          <h3 class="inventory-subsection-title">Evolution Items</h3>
          <% @evolution_items.each do |item_data| %>
            <div class="inventory-item">
              <span class="inventory-item-label">
                <%= image_tag "icons/#{item_data[:item].sprite}", alt: item_data[:item].name, class: "inventory-icon" %>
                <%= item_data[:item].name %>
              </span>
              <span class="inventory-item-count"><%= item_data[:quantity] %></span>
            </div>
          <% end %>
        <% end %>

        <!-- Adventure Items Section -->
        <% if @adventure_items.any? %>
          <h3 class="inventory-subsection-title">Adventure Items</h3>
          <% @adventure_items.each do |item_data| %>
            <div class="inventory-item">
              <span class="inventory-item-label">
                <%= image_tag "icons/#{item_data[:item].sprite}", alt: item_data[:item].name, class: "inventory-icon" %>
                <%= item_data[:item].name %>
              </span>
              <span class="inventory-item-count"><%= item_data[:quantity] %></span>
            </div>
          <% end %>
        <% end %>

        <!-- Empty Inventory Message -->
        <% if @pokeball_items.empty? && @evolution_items.empty? && @adventure_items.empty? %>
          <p class="inventory-empty">Your inventory is empty.</p>
        <% end %>
      </div>

      <!-- Pokédex Overview Card -->
      <div class="card-dashboard">
        <div class="card-dashboard-header">
          <span class="card-dashboard-icon"><%= image_tag "icons/pokedex.png", alt: "Pokedex", class: "card-dashboard-icon-image" %></span>
          <h2 class="card-dashboard-title">Pokédex Progress</h2>
        </div>

        <div class="pokedex-stats">
          <p class="pokedex-count"><%= @trainer.captures.count %></p>
          <p class="pokedex-label">Pokémon Captured</p>

          <% completion = (@trainer.captures.count.to_f / 151 * 100).round(1) %>
          <div class="progress-bar">
            <div class="progress-bar-fill" style="width: <%= completion %>%;"></div>
          </div>

          <p class="progress-text"><%= @trainer.captures.count %> / 151 Pokémon (<%= completion %>%)</p>
        </div>
      </div>

      <!-- News Feed Card -->
      <div class="card-dashboard news-feed-card">
        <div class="card-dashboard-header">
          <span class="card-dashboard-icon">📰</span>
          <h2 class="card-dashboard-title">News Feed</h2>
        </div>

        <div class="news-feed">
          <% if @news_feed.any? %>
            <% @news_feed.each do |event| %>
              <div class="news-item" data-event-type="<%= event[:type] %>">
                <div class="news-item-content">
                  <%= image_tag "pokemonSprites/#{event[:pokemon].pokedex_number.to_s.rjust(3, '0')}.png",
                                alt: event[:pokemon].name,
                                class: "news-pokemon-sprite" %>
                  <div class="news-item-text">
                    <span class="news-trainer"><%= event[:trainer].username %></span>
                    <% if event[:type] == 'caught' %>
                      caught a <span class="news-pokemon"><%= event[:pokemon].name %></span>!
                    <% else %>
                      evolved <span class="news-pokemon"><%= event[:pokemon].name %></span>!
                    <% end %>
                    <span class="news-timestamp"><%= time_ago_in_words(event[:timestamp]) %> ago</span>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="news-feed-empty">No recent activity from other trainers.</p>
          <% end %>
        </div>
      </div>
    </div>
  </main>
</div>
