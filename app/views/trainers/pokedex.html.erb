<div>
  <%= render "trainers/header" %>

  <div>
    <div>
      <div>
        <div>
          <div>
            <span>📖</span>
          </div>
          <div>
            <h2>Your Pokédex</h2>
            <p>Track your captured Pokémon collection</p>
          </div>
        </div>
        <div>
          <p><%= @captured_pokemon.count %></p>
          <p>Captured</p>
        </div>
      </div>

      <div>
        <div>
          <% completion = (@captured_pokemon.count.to_f / 151 * 100).round(1) %>
          <div></div>
        </div>
        <p><%= completion %>% Complete (<%= @captured_pokemon.count %> / 151 Pokémon)</p>
      </div>
    </div>

    <% if @captured_pokemon.any? %>
      <div>
        <% @captured_pokemon.each do |pokemon| %>
          <% capture = @trainer.captures.find_by(pokemon: pokemon) %>
          <div>
            <div>
              <% if pokemon.image.attached? %>
                <%= image_tag pokemon.image, alt: pokemon.name %>
              <% else %>
                <div>?</div>
              <% end %>
            </div>
            <div>
              <div>#<%= pokemon.pokedex_number.to_s.rjust(3, '0') %></div>
              <h3><%= pokemon.name %></h3>
              <div>
                <span><%= capture.ball_type.humanize %></span>
                <span><%= capture.captured_at.strftime("%m/%d") %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div>
        <div>
          <span>🎣</span>
        </div>
        <h3>No Pokémon Yet!</h3>
        <p>You haven't caught any Pokémon yet.<br/>Complete tickets to earn Pokéballs!</p>
        <%= link_to "Get Pokéballs →", rewards_path %>
      </div>
    <% end %>
  </div>
</div>
