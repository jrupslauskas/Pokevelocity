<div class="min-h-screen bg-gradient-to-b from-green-200 via-lime-100 to-emerald-200" style="background-color: #E8F5E8;">
  <!-- Header -->
  <%= render "trainers/header" %>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Title -->
    <div class="rounded-lg shadow-xl p-6 mb-8 border-4 text-center" style="background: linear-gradient(to bottom, #FFFACD, #F5F0E8); border-color: #8B6F47;">
      <div class="text-6xl mb-4">🎣</div>
      <h2 class="text-3xl font-bold mb-2" style="color: #2C5F2D;">Catch a Pokémon!</h2>
      <p class="text-gray-700">Choose which Pokémon you want to catch</p>
      <div class="mt-4 text-sm text-gray-600 font-semibold">
        <%= @trainer.captures.count %> / 151 Pokémon Caught · <%= @uncaught_pokemon.count %> Available to Catch
      </div>
    </div>

    <!-- Instructions -->
    <div class="rounded-lg border-4 p-4 mb-8" style="background: linear-gradient(to bottom, #E8FFDC, #F0FFE8); border-color: #7AC74C;">
      <p class="font-semibold mb-2" style="color: #2C5F2D;">How to Catch Pokémon:</p>
      <ol class="list-decimal list-inside text-sm space-y-1" style="color: #3D7A4E;">
        <li>Browse the uncaught Pokémon below</li>
        <li>Click "Catch This Pokémon" on the one you want</li>
        <li>Select which Pokéball to use based on difficulty</li>
        <li>The Pokéball will be consumed whether you succeed or fail!</li>
      </ol>
    </div>

    <!-- Pokemon Grid -->
    <% if @uncaught_pokemon.any? %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 mb-8">
        <% @uncaught_pokemon.each do |pokemon| %>
          <%= link_to select_pokemon_path(pokemon), class: "rounded-lg shadow-lg border-4 overflow-hidden hover:scale-105 transition-all", style: "background: linear-gradient(to bottom, #FFF8DC, #F5F0E8); border-color: #A67C52;" do %>
            <div class="p-4 flex items-center justify-center h-32" style="background-color: #F0E8D8;">
              <% if pokemon.image.attached? %>
                <%= image_tag pokemon.image, alt: pokemon.name, class: "max-h-full max-w-full object-contain" %>
              <% else %>
                <div class="text-gray-400 text-4xl">?</div>
              <% end %>
            </div>
            <div class="p-3 text-center">
              <div class="text-xs text-gray-600 font-semibold">#<%= pokemon.pokedex_number.to_s.rjust(3, '0') %></div>
              <h3 class="text-lg font-bold capitalize" style="color: #2C5F2D;"><%= pokemon.name %></h3>
              <div class="mt-2 text-white text-sm font-semibold py-1 px-3 rounded-full" style="background: linear-gradient(to right, #7AC74C, #5FA777);">
                Catch This Pokémon
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <!-- All Caught Message -->
      <div class="rounded-lg shadow-xl p-12 text-center border-4 mb-8" style="background: linear-gradient(to bottom, #FFFACD, #F5F0E8); border-color: #D4AF37;">
        <div class="text-6xl mb-4">🎉</div>
        <h3 class="text-2xl font-bold mb-2" style="color: #2C5F2D;">Congratulations!</h3>
        <p class="text-gray-700">You've caught all 151 Pokémon!</p>
      </div>
    <% end %>

    <!-- Total Inventory -->
    <div class="rounded-lg shadow-xl p-4 border-4 text-center mb-8" style="background: linear-gradient(to bottom, #E8FFDC, #F0FFE8); border-color: #7AC74C;">
      <p class="text-gray-700 mb-1 font-semibold">Total Pokéballs Available</p>
      <p class="text-4xl font-bold" style="color: #5FA777;"><%= @trainer.total_pokeballs %></p>
    </div>

    <!-- Back Button -->
    <div class="flex gap-4">
      <%= link_to rewards_path, class: "flex-1 text-white text-center font-bold py-3 px-6 rounded-lg transition-all shadow-lg border-3", style: "background: linear-gradient(to bottom, #7AC74C, #5FA777); border-color: #3D7A4E;" do %>
        Get More Pokéballs
      <% end %>
      <%= link_to dashboard_path, class: "flex-1 text-white text-center font-bold py-3 px-6 rounded-lg transition-all shadow-lg", style: "background: linear-gradient(to bottom, #A67C52, #8B6F47); border-color: #6B5537;" do %>
        Back to Dashboard
      <% end %>
    </div>
  </div>
</div>
