<div>
  <%= render "trainers/header" %>

  <div>
    <div>
      <div>🎣</div>
      <h2>Catch a Pokémon!</h2>
      <p>Choose which Pokémon you want to catch</p>
      <div>
        <%= @trainer.captures.count %> / 151 Pokémon Caught · <%= @uncaught_pokemon.count %> Available to Catch
      </div>
    </div>

    <div>
      <p>How to Catch Pokémon:</p>
      <ol>
        <li>Browse the uncaught Pokémon below</li>
        <li>Click "Catch This Pokémon" on the one you want</li>
        <li>Select which Pokéball to use based on difficulty</li>
        <li>The Pokéball will be consumed whether you succeed or fail!</li>
      </ol>
    </div>

    <% if @uncaught_pokemon.any? %>
      <div>
        <% @uncaught_pokemon.each do |pokemon| %>
          <%= link_to select_pokemon_path(pokemon) do %>
            <div>
              <% if pokemon.image.attached? %>
                <%= image_tag pokemon.image, alt: pokemon.name %>
              <% else %>
                <div>?</div>
              <% end %>
            </div>
            <div>
              <div>#<%= pokemon.pokedex_number.to_s.rjust(3, '0') %></div>
              <h3><%= pokemon.name %></h3>
              <div>Catch This Pokémon</div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div>
        <div>🎉</div>
        <h3>Congratulations!</h3>
        <p>You've caught all 151 Pokémon!</p>
      </div>
    <% end %>

    <div>
      <p>Total Pokéballs Available</p>
      <p><%= @trainer.total_pokeballs %></p>
    </div>

    <div>
      <%= link_to "Get More Pokéballs", rewards_path %>
      <%= link_to "Back to Dashboard", dashboard_path %>
    </div>
  </div>
</div>
