<div>
  <%= render "trainers/header" %>

  <div>
    <div>
      <div>
        <span>🎁</span>
      </div>
      <h2>Redeem Rewards</h2>
      <p>Complete tickets to earn Pokéballs!</p>
    </div>

    <div>
      <div>
        <div>
          <span>✅</span>
        </div>
        <h3>Completed a Ticket?</h3>
        <p>Enter the story points from your completed ticket to receive a Pokéball reward!</p>
      </div>

      <%= form_with url: rewards_path, method: :post, local: true do |f| %>
        <div>
          <%= label_tag :story_points, "Story Points" %>
          <%= number_field_tag :story_points, nil,
              min: 1,
              max: 13,
              placeholder: "Enter points (1, 2, 3, 5, 8, 13)",
              autofocus: true,
              required: true %>
          <p>💡 Common values: 1, 2, 3, 5, 8, 13</p>
        </div>

        <div>
          <%= submit_tag "Claim Reward!" %>
        </div>
      <% end %>
    </div>

    <div>
      <div>
        <div>
          <span>📊</span>
        </div>
        <h3>Reward Probabilities</h3>
      </div>
      <p>Different story points have different chances of earning various Pokéballs:</p>

      <div>
        <div>
          <div>
            <div>
              <div>1-2 Point Tickets</div>
              <div>Mostly Pokéballs, small chance of Great Balls</div>
            </div>
            <span>⚪</span>
          </div>
        </div>

        <div>
          <div>
            <div>
              <div>3 Point Tickets</div>
              <div>Mix of Pokéballs and Great Balls</div>
            </div>
            <span>🔵</span>
          </div>
        </div>

        <div>
          <div>
            <div>
              <div>5 Point Tickets</div>
              <div>Mostly Great Balls, chance of Ultra Balls</div>
            </div>
            <span>🟡</span>
          </div>
        </div>

        <div>
          <div>
            <div>
              <div>8+ Point Tickets</div>
              <div>Mostly Ultra Balls, chance of Master Balls!</div>
            </div>
            <span>🟣</span>
          </div>
        </div>
      </div>

      <div>
        <div>
          <span>💡</span>
          <p>Tip: Bigger tickets = Better rewards!</p>
        </div>
      </div>
    </div>

    <div>
      <%= link_to "← Back to Dashboard", dashboard_path %>
    </div>
  </div>
</div>
