<div>
  <%= render "trainers/header" %>

  <div>
    <div>
      <div>
        <% if @pokemon.image.attached? %>
          <%= image_tag @pokemon.image, alt: @pokemon.name %>
        <% else %>
          <div>?</div>
        <% end %>
      </div>
      <div>#<%= @pokemon.pokedex_number.to_s.rjust(3, '0') %></div>
      <h2><%= @pokemon.name %></h2>

      <div>
        <p>Capture Difficulty</p>
        <div>
          <% @pokemon.difficulty.times do %>
            <span>★</span>
          <% end %>
          <% (5 - @pokemon.difficulty).times do %>
            <span>★</span>
          <% end %>
        </div>
        <p>
          <%= case @pokemon.difficulty
              when 1 then "Very Easy"
              when 2 then "Easy"
              when 3 then "Medium"
              when 4 then "Hard"
              when 5 then "Very Hard"
              end %>
        </p>
      </div>

      <p>Choose a Pokéball to catch this Pokémon</p>
    </div>

    <h3>Select Your Pokéball</h3>

    <div>
      <%= form_with url: select_pokemon_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "pokeball" %>
        <button type="submit" <%= "disabled" if @trainer.pokeballs_count == 0 %>>
          <div>
            <div>
              <div>⚪</div>
              <div>
                <h4>Pokéball</h4>
                <p>Standard Pokéball</p>
                <p><%= @catch_probabilities["pokeball"] %>% catch rate</p>
              </div>
            </div>
            <div>
              <p><%= @trainer.pokeballs_count %></p>
              <p>Available</p>
            </div>
          </div>
          <% if @trainer.pokeballs_count > 0 %>
            <div>Use Pokéball</div>
          <% else %>
            <div>None Available</div>
          <% end %>
        </button>
      <% end %>

      <%= form_with url: select_pokemon_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "great_ball" %>
        <button type="submit" <%= "disabled" if @trainer.great_balls_count == 0 %>>
          <div>
            <div>
              <div>🔵</div>
              <div>
                <h4>Great Ball</h4>
                <p>Enhanced Pokéball</p>
                <p><%= @catch_probabilities["great_ball"] %>% catch rate</p>
              </div>
            </div>
            <div>
              <p><%= @trainer.great_balls_count %></p>
              <p>Available</p>
            </div>
          </div>
          <% if @trainer.great_balls_count > 0 %>
            <div>Use Great Ball</div>
          <% else %>
            <div>None Available</div>
          <% end %>
        </button>
      <% end %>

      <%= form_with url: select_pokemon_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "ultra_ball" %>
        <button type="submit" <%= "disabled" if @trainer.ultra_balls_count == 0 %>>
          <div>
            <div>
              <div>🟡</div>
              <div>
                <h4>Ultra Ball</h4>
                <p>High-performance</p>
                <p><%= @catch_probabilities["ultra_ball"] %>% catch rate</p>
              </div>
            </div>
            <div>
              <p><%= @trainer.ultra_balls_count %></p>
              <p>Available</p>
            </div>
          </div>
          <% if @trainer.ultra_balls_count > 0 %>
            <div>Use Ultra Ball</div>
          <% else %>
            <div>None Available</div>
          <% end %>
        </button>
      <% end %>

      <%= form_with url: select_pokemon_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "master_ball" %>
        <button type="submit" <%= "disabled" if @trainer.master_balls_count == 0 %>>
          <div>
            <div>
              <div>🟣</div>
              <div>
                <h4>Master Ball</h4>
                <p>Ultimate Pokéball</p>
                <p><%= @catch_probabilities["master_ball"] %>% catch rate</p>
              </div>
            </div>
            <div>
              <p><%= @trainer.master_balls_count %></p>
              <p>Available</p>
            </div>
          </div>
          <% if @trainer.master_balls_count > 0 %>
            <div>Use Master Ball</div>
          <% else %>
            <div>None Available</div>
          <% end %>
        </button>
      <% end %>
    </div>

    <div>
      <%= link_to "← Back to Pokémon List", catch_pokemon_path %>
    </div>
  </div>
</div>
