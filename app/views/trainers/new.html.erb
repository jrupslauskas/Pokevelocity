<div>
  <div class="page-header" style="margin-bottom: 8px;">
    <div class="title-row">
      <div class="logo-placeholder"><%= image_tag "icons/pokevelocity_logo.png", alt: "Pokevelocity Logo", class: "logo-image" %></div>
      <h1 class="page-title">Pokévelocity</h1>
    </div>
  </div>

  <div style="text-align: center; margin-bottom: 32px;">
    <p class="tagline">Gotta Code 'Em All!</p>
    <p class="tagline">Complete tickets · Earn Pokéballs · Catch 'em all!</p>
  </div>

  <div class="card">
    <h2 class="card-title">Create Your Account</h2>
    <p class="card-subtitle">Choose your trainer name and set a password (Don't use sensitive credentials or work information)</p>

    <%= form_with model: @trainer, url: trainers_path, method: :post, local: true do |f| %>
      <% if @trainer.errors.any? %>
        <div style="background-color: #FFE8E8; border: 2px solid #C97A7A; border-radius: 10px; padding: 16px; margin-bottom: 20px;">
          <p style="color: #C97A7A; font-weight: 600; margin: 0 0 8px 0;">Please fix the following errors:</p>
          <ul style="margin: 0; padding-left: 20px; color: #8B6F47;">
            <% @trainer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :username, "Trainer Name", class: "form-label" %>
        <%= f.text_field :username,
            placeholder: "Choose your unique trainer name",
            autofocus: true,
            required: true,
            maxlength: 16,
            class: "form-input" %>
        <p style="font-size: 13px; color: #8B6F47; margin: 6px 0 0 0;">This will be your display name in the app (16 characters max)</p>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password", class: "form-label" %>
        <%= f.password_field :password,
            placeholder: "Create a password",
            required: true,
            class: "form-input" %>
      </div>

      <div class="form-group">
        <div style="display: flex; align-items: center;">
          <%= label_tag :icon_selection, class: "form-label", style: "margin-bottom: 0;" do %>
            Choose Your Icon <span style="color: #E85D75;">*</span>
          <% end %>
          <div class="info-icon-wrapper">
            <div class="info-icon">i</div>
            <div class="info-tooltip">
              This will represent you throughout the app. Your choice won't have any functional impact on your experience.
            </div>
          </div>
        </div>

        <!-- Toggle between Pokemon and Trainers -->
        <div style="display: flex; gap: 8px; margin-top: 12px; margin-bottom: 16px;">
          <button type="button" id="toggle-pokemon" class="icon-toggle-btn active" onclick="showIconType('pokemon')">
            Pokémon
          </button>
          <button type="button" id="toggle-trainers" class="icon-toggle-btn" onclick="showIconType('trainers')">
            Trainers
          </button>
        </div>

        <!-- Pokemon Grid -->
        <div id="pokemon-grid" class="icon-pokemon-grid" style="display: grid;">
          <% @pokemon.each do |pokemon| %>
            <label class="icon-pokemon-option">
              <%= f.radio_button :icon_pokemon_id, pokemon.id, required: false, class: "icon-pokemon-radio icon-selection-radio", data: { type: "pokemon" } %>
              <div class="icon-pokemon-card">
                <% if pokemon.image.attached? %>
                  <%= image_tag pokemon.image, alt: pokemon.name, class: "icon-pokemon-image" %>
                <% else %>
                  <%= image_tag "pokemonSprites/#{pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
                      alt: pokemon.name,
                      class: "icon-pokemon-image",
                      style: "image-rendering: pixelated;" %>
                <% end %>
                <span class="icon-pokemon-name"><%= pokemon.name %></span>
              </div>
            </label>
          <% end %>
        </div>

        <!-- Trainer Sprites Grid -->
        <div id="trainers-grid" class="icon-pokemon-grid" style="display: none;">
          <% @trainer_sprites.each do |sprite_name| %>
            <% display_name = sprite_name.split('/').last.titleize %>
            <label class="icon-pokemon-option">
              <%= f.radio_button :icon_trainer_sprite, sprite_name, required: false, class: "icon-pokemon-radio icon-selection-radio", data: { type: "trainer" } %>
              <div class="icon-pokemon-card">
                <%= image_tag "trainerSprites/#{sprite_name}.png",
                    alt: display_name,
                    class: "icon-pokemon-image" %>
                <span class="icon-pokemon-name"><%= display_name %></span>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <div class="form-group">
        <%= label_tag :activation_code, "Activation Code", class: "form-label" %>
        <%= text_field_tag :activation_code, nil,
            placeholder: "Enter 6-character code",
            required: true,
            minlength: 6,
            maxlength: 6,
            class: "form-input",
            style: "text-transform: uppercase;" %>
        <p style="font-size: 13px; color: #8B6F47; margin: 6px 0 0 0;">Contact the admin for the activation code</p>
      </div>

      <div class="form-group" style="display: flex; gap: 10px; align-items: start;">
        <%= check_box_tag :honor_system_agreement, "1", false,
            required: true,
            style: "width: 20px; height: 20px; margin-top: 2px; cursor: pointer; flex-shrink: 0;" %>
        <%= label_tag :honor_system_agreement,
            "I acknowledge that this app operates on the honor system. No validation is done to vet the completion of tickets, however swindling velocity inflators will ruin the fun, so I agree to not be a Team Rocket Grunt and will only claim credit for tickets I actually complete.",
            style: "font-size: 14px; color: #6B5537; line-height: 1.5; cursor: pointer; margin: 0;" %>
      </div>

      <div class="form-group-center">
        <%= f.submit "Create Trainer Account", class: "btn-primary" %>
      </div>
    <% end %>

    <p class="text-secondary">
      Already have an account?
      <%= link_to "Log In", login_path, class: "link-secondary" %>
    </p>
  </div>

  <footer class="page-footer">
    <p class="footer-text">
      <%= link_to "View on GitHub", "https://github.com/jrupslauskas/Pokevelocity", target: "_blank", class: "footer-link" %>
    </p>
  </footer>

  <script>
    function showIconType(type) {
      const pokemonGrid = document.getElementById('pokemon-grid');
      const trainersGrid = document.getElementById('trainers-grid');
      const pokemonToggle = document.getElementById('toggle-pokemon');
      const trainersToggle = document.getElementById('toggle-trainers');

      if (type === 'pokemon') {
        // Show Pokemon grid
        pokemonGrid.style.display = 'grid';
        trainersGrid.style.display = 'none';
        pokemonToggle.classList.add('active');
        trainersToggle.classList.remove('active');

        // Clear trainer sprite selections
        document.querySelectorAll('input[name="trainer[icon_trainer_sprite]"]').forEach(radio => {
          radio.checked = false;
        });
      } else {
        // Show Trainers grid
        pokemonGrid.style.display = 'none';
        trainersGrid.style.display = 'grid';
        trainersToggle.classList.add('active');
        pokemonToggle.classList.remove('active');

        // Clear Pokemon selections
        document.querySelectorAll('input[name="trainer[icon_pokemon_id]"]').forEach(radio => {
          radio.checked = false;
        });
      }
    }

    // Add validation to ensure at least one icon is selected before submitting
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.querySelector('form');

      form.addEventListener('submit', function(e) {
        const pokemonSelected = document.querySelector('input[name="trainer[icon_pokemon_id]"]:checked');
        const trainerSelected = document.querySelector('input[name="trainer[icon_trainer_sprite]"]:checked');

        if (!pokemonSelected && !trainerSelected) {
          e.preventDefault();
          alert('Please select an icon (Pokémon or Trainer)');
          return false;
        }
      });
    });
  </script>
</div>
