<div class="min-h-screen bg-gradient-to-b from-blue-400 via-blue-300 to-green-300 flex items-center justify-center p-4">
  <div class="max-w-md w-full">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-5xl font-bold text-white drop-shadow-lg mb-2">
        Become a Trainer
      </h1>
      <p class="text-lg text-white drop-shadow-md">Join Pokévelocity and start your adventure!</p>
    </div>

    <!-- Registration Card -->
    <div class="bg-white rounded-3xl shadow-2xl p-8 border-4 border-yellow-400">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-2">Create Your Account</h2>
        <p class="text-gray-600">Choose your trainer name and set a password (This is a pretty unserious app, dont use any sensitive username or passwords)</p>
      </div>

      <%= form_with model: @trainer, url: trainers_path, method: :post, local: true, class: "space-y-6" do |f| %>
        <% if @trainer.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded">
            <p class="font-semibold text-red-800 mb-2">Please fix the following errors:</p>
            <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
              <% @trainer.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :username, "Trainer Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_field :username,
              placeholder: "Choose a unique trainer name",
              class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors",
              autofocus: true,
              required: true %>
          <p class="mt-1 text-xs text-gray-500">This will be your display name</p>
        </div>

        <div>
          <%= f.label :password, "Password", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.password_field :password,
              placeholder: "Choose a password",
              class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors",
              required: true %>
        </div>

        <div>
          <%= f.submit "Create Trainer Account",
              class: "w-full bg-gradient-to-r from-green-500 to-green-600 text-white font-bold py-3 px-6 rounded-lg hover:from-green-600 hover:to-green-700 transition-all transform hover:scale-105 shadow-lg cursor-pointer" %>
        </div>
      <% end %>

      <!-- Back to Login Link -->
      <div class="mt-6 text-center">
        <p class="text-gray-600">
          Already have an account?
          <%= link_to "Log In", login_path,
              class: "font-bold text-blue-600 hover:text-blue-800 hover:underline" %>
        </p>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-8">
      <p class="text-white text-sm drop-shadow-md">
        Start your journey to catch 'em all!
      </p>
    </div>
  </div>
</div>
