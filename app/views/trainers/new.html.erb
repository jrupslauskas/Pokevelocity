<div>
  <div>
    <h1>Become a Trainer</h1>
    <p>Join Pokévelocity and start your adventure!</p>
  </div>

  <div>
    <h2>Create Your Account</h2>
    <p>Choose your trainer name and set a password (Don't use sensitive credentials - this is just for fun!)</p>

    <%= form_with model: @trainer, url: trainers_path, method: :post, local: true do |f| %>
      <% if @trainer.errors.any? %>
        <div>
          <p>Please fix the following errors:</p>
          <ul>
            <% @trainer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :username, "Trainer Name" %>
        <%= f.text_field :username,
            placeholder: "Choose your unique trainer name",
            autofocus: true,
            required: true %>
        <p>This will be your display name in the app</p>
      </div>

      <div>
        <%= f.label :password, "Password" %>
        <%= f.password_field :password,
            placeholder: "Create a password",
            required: true %>
      </div>

      <div>
        <%= f.submit "Create Trainer Account" %>
      </div>
    <% end %>

    <div>
      <p>
        Already have an account?
        <%= link_to "Log In", login_path %>
      </p>
    </div>
  </div>

  <div>
    <p>Start your journey to catch 'em all!</p>
  </div>
</div>
