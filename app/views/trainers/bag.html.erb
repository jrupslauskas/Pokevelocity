<div>
  <%= render "trainers/header" %>

  <div>
    <div>
      <div>
        <span>🎒</span>
      </div>
      <h2>Your Bag</h2>
      <p>View your Pokéball inventory</p>
    </div>

    <div>
      <div>
        <div>
          <div>
            <div>⚪</div>
          </div>
          <div>
            <h3>Pokéball</h3>
            <p>Standard Pokéball for catching Pokémon</p>
          </div>
        </div>
        <div>
          <p><%= @trainer.pokeballs_count %></p>
          <p>Available</p>
        </div>
      </div>

      <div>
        <div>
          <div>
            <div>🔵</div>
          </div>
          <div>
            <h3>Great Ball</h3>
            <p>Enhanced Pokéball with better catch rate</p>
          </div>
        </div>
        <div>
          <p><%= @trainer.great_balls_count %></p>
          <p>Available</p>
        </div>
      </div>

      <div>
        <div>
          <div>
            <div>🟡</div>
          </div>
          <div>
            <h3>Ultra Ball</h3>
            <p>High-performance Pokéball for tough catches</p>
          </div>
        </div>
        <div>
          <p><%= @trainer.ultra_balls_count %></p>
          <p>Available</p>
        </div>
      </div>

      <div>
        <div>
          <div>
            <div>🟣</div>
          </div>
          <div>
            <h3>Master Ball</h3>
            <p>Ultimate Pokéball with guaranteed catch!</p>
          </div>
        </div>
        <div>
          <p><%= @trainer.master_balls_count %></p>
          <p>Available</p>
        </div>
      </div>
    </div>

    <div>
      <div>
        <div>
          <div>
            <span>✨</span>
          </div>
          <div>
            <h3>Total Pokéballs</h3>
            <p>Combined inventory</p>
          </div>
        </div>
        <div>
          <p><%= @trainer.total_pokeballs %></p>
        </div>
      </div>
    </div>

    <div>
      <%= link_to "🎁 Get More Pokéballs", rewards_path %>
      <%= link_to "← Back to Dashboard", dashboard_path %>
    </div>
  </div>
</div>
