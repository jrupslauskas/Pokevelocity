<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <h1>Wild <%= @pokemon.name.capitalize %> appeared!</h1>
      <p>Select a Pokéball to attempt catching this Pokémon.</p>
    </header>

    <!-- Stats Bar -->
    <div class="catch-stats-bar">
      <div class="catch-stat">
        <span class="catch-stat-label">Adventures</span>
        <span class="catch-stat-value <%= 'adventure-depleted' if @trainer.adventures_remaining == 0 %>">
          <%= @trainer.adventures_remaining %> / 10
        </span>
      </div>
      <div class="catch-stat">
        <span class="catch-stat-label">Caught</span>
        <span class="catch-stat-value"><%= @trainer.captures.count %> / 151</span>
      </div>
      <div class="catch-stat">
        <span class="catch-stat-label">Difficulty Score</span>
        <span class="catch-stat-value"><%= @trainer.difficulty_score %></span>
      </div>
      <div class="catch-stat">
        <span class="catch-stat-label">Pokéballs</span>
        <span class="catch-stat-value"><%= @trainer.total_pokeballs %></span>
      </div>
    </div>

    <!-- Pokemon Info Card -->
    <div class="select-pokemon-card">
      <div class="select-pokemon-image">
        <% if @pokemon.image.attached? %>
          <%= image_tag @pokemon.image, alt: @pokemon.name %>
        <% else %>
          <%= image_tag "pokemonSprites/#{@pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
              alt: @pokemon.name,
              style: "image-rendering: pixelated;" %>
        <% end %>
      </div>

      <div class="select-pokemon-info">
        <p class="select-pokemon-number">#<%= @pokemon.pokedex_number.to_s.rjust(3, '0') %></p>
        <h2 class="select-pokemon-name"><%= @pokemon.name.capitalize %></h2>

        <div class="select-pokemon-difficulty">
          <span class="difficulty-label">Capture Difficulty:</span>
          <div class="difficulty-stars">
            <% @pokemon.difficulty.times do %>
              <span class="star-filled">★</span>
            <% end %>
            <% (5 - @pokemon.difficulty).times do %>
              <span class="star-empty">★</span>
            <% end %>
          </div>
          <span class="difficulty-text">
            <%= case @pokemon.difficulty
                when 1 then "Very Easy"
                when 2 then "Easy"
                when 3 then "Medium"
                when 4 then "Hard"
                when 5 then "Very Hard"
                end %>
          </span>
        </div>
      </div>
    </div>

    <% if @already_caught %>
      <div class="already-caught-notice" style="max-width: 600px; margin: 24px auto; padding: 16px; background: linear-gradient(135deg, #FFF4E6 0%, #FFE8CC 100%); border: 2px solid #F4A460; border-radius: 12px; text-align: center;">
        <p class="already-caught-title" style="margin: 0; color: #8B4513; font-size: 16px; font-weight: 600;">
          ✓ Already in your Pokédex!
        </p>
        <p class="already-caught-text" style="margin: 8px 0 0 0; color: #6B5537; font-size: 14px;">
          Catching <%= @pokemon.name %> again will reward you with an Evolution Stone.
        </p>
      </div>
    <% end %>

    <!-- Pokeball Selection -->
    <h3 class="pokeball-selection-title">Select Your Pokéball</h3>

    <div class="pokeball-grid">
      <%= form_with url: catch_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "pokeball" %>
        <button type="submit" class="pokeball-card <%= 'pokeball-disabled' if @trainer.ball_count(:pokeball) == 0 %>" <%= "disabled" if @trainer.ball_count(:pokeball) == 0 %>>
          <div class="pokeball-card-icon"><%= image_tag "icons/pokeball_shop.png", alt: "Pokeball", class: "pokeball-icon-image" %></div>
          <div class="pokeball-card-content">
            <h4 class="pokeball-card-name">Pokéball</h4>
            <p class="pokeball-card-description">Standard Pokéball</p>
            <p class="pokeball-card-rate"><%= @catch_probabilities["pokeball"] %>% catch rate</p>
          </div>
          <div class="pokeball-card-count">
            <span class="pokeball-count-number"><%= @trainer.ball_count(:pokeball) %></span>
            <span class="pokeball-count-label">Available</span>
          </div>
        </button>
      <% end %>

      <%= form_with url: catch_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "great_ball" %>
        <button type="submit" class="pokeball-card <%= 'pokeball-disabled' if @trainer.ball_count(:great_ball) == 0 %>" <%= "disabled" if @trainer.ball_count(:great_ball) == 0 %>>
          <div class="pokeball-card-icon"><%= image_tag "icons/greatball.png", alt: "Great Ball", class: "pokeball-icon-image" %></div>
          <div class="pokeball-card-content">
            <h4 class="pokeball-card-name">Great Ball</h4>
            <p class="pokeball-card-description">Enhanced Pokéball</p>
            <p class="pokeball-card-rate"><%= @catch_probabilities["great_ball"] %>% catch rate</p>
          </div>
          <div class="pokeball-card-count">
            <span class="pokeball-count-number"><%= @trainer.ball_count(:great_ball) %></span>
            <span class="pokeball-count-label">Available</span>
          </div>
        </button>
      <% end %>

      <%= form_with url: catch_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "ultra_ball" %>
        <button type="submit" class="pokeball-card <%= 'pokeball-disabled' if @trainer.ball_count(:ultra_ball) == 0 %>" <%= "disabled" if @trainer.ball_count(:ultra_ball) == 0 %>>
          <div class="pokeball-card-icon"><%= image_tag "icons/ultraball.jpg", alt: "Ultra Ball", class: "pokeball-icon-image" %></div>
          <div class="pokeball-card-content">
            <h4 class="pokeball-card-name">Ultra Ball</h4>
            <p class="pokeball-card-description">High-performance</p>
            <p class="pokeball-card-rate"><%= @catch_probabilities["ultra_ball"] %>% catch rate</p>
          </div>
          <div class="pokeball-card-count">
            <span class="pokeball-count-number"><%= @trainer.ball_count(:ultra_ball) %></span>
            <span class="pokeball-count-label">Available</span>
          </div>
        </button>
      <% end %>

      <%= form_with url: catch_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "master_ball" %>
        <button type="submit" class="pokeball-card <%= 'pokeball-disabled' if @trainer.ball_count(:master_ball) == 0 %>" <%= "disabled" if @trainer.ball_count(:master_ball) == 0 %>>
          <div class="pokeball-card-icon"><%= image_tag "icons/masterball.png", alt: "Master Ball", class: "pokeball-icon-image" %></div>
          <div class="pokeball-card-content">
            <h4 class="pokeball-card-name">Master Ball</h4>
            <p class="pokeball-card-description">Ultimate Pokéball</p>
            <p class="pokeball-card-rate"><%= @catch_probabilities["master_ball"] %>% catch rate</p>
          </div>
          <div class="pokeball-card-count">
            <span class="pokeball-count-number"><%= @trainer.ball_count(:master_ball) %></span>
            <span class="pokeball-count-label">Available</span>
          </div>
        </button>
      <% end %>

      <%= form_with url: run_from_catch_path(@pokemon), method: :post, local: true do |f| %>
        <button type="submit" class="pokeball-card run-card">
          <div class="pokeball-card-icon run-icon">🏃</div>
          <div class="pokeball-card-content">
            <h4 class="pokeball-card-name">Run</h4>
            <p class="pokeball-card-description">Flee from battle</p>
            <p class="pokeball-card-rate">&nbsp;</p>
          </div>
          <div class="pokeball-card-count run-card-footer">
            <span class="pokeball-count-label">Run</span>
          </div>
        </button>
      <% end %>

      <% if @last_adventure.present? %>
        <% if @trainer.has_adventures? %>
          <%= form_with url: adventure_path(@last_adventure['route_id']), method: :post, local: true do |f| %>
            <%= f.hidden_field :encounter_type, value: @last_adventure['encounter_type'] %>
            <%= f.hidden_field :rod_type, value: @last_adventure['rod_type'] if @last_adventure['rod_type'].present? %>
            <button type="submit" class="pokeball-card adventure-again-card">
              <div class="pokeball-card-icon adventure-again-icon">🔄</div>
              <div class="pokeball-card-content">
                <h4 class="pokeball-card-name">Adventure Again</h4>
                <p class="pokeball-card-description">Same route & type</p>
                <p class="pokeball-card-rate">&nbsp;</p>
              </div>
              <div class="pokeball-card-count adventure-again-card-footer">
                <span class="pokeball-count-label">Again</span>
              </div>
            </button>
          <% end %>
        <% else %>
          <button type="button" class="pokeball-card pokeball-disabled adventure-again-card-disabled" disabled>
            <div class="pokeball-card-icon adventure-again-icon">🔄</div>
            <div class="pokeball-card-content">
              <h4 class="pokeball-card-name">No More Adventures</h4>
              <p class="pokeball-card-description">Visit again tomorrow</p>
              <p class="pokeball-card-rate">&nbsp;</p>
            </div>
            <div class="pokeball-card-count adventure-again-card-footer">
              <span class="pokeball-count-label">Depleted</span>
            </div>
          </button>
        <% end %>
      <% end %>
    </div>
  </main>
</div>
