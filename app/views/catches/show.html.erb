<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <h1>Catch <%= @pokemon.name.capitalize %></h1>
      <p>Select a Pokéball to attempt catching this Pokémon.</p>
    </header>

    <!-- Pokemon Info Card -->
    <div class="select-pokemon-card">
      <div class="select-pokemon-image">
        <% if @pokemon.image.attached? %>
          <%= image_tag @pokemon.image, alt: @pokemon.name %>
        <% else %>
          <%= image_tag "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/#{@pokemon.pokedex_number}.png",
              alt: @pokemon.name,
              style: "image-rendering: pixelated;" %>
        <% end %>
      </div>

      <div class="select-pokemon-info">
        <p class="select-pokemon-number">#<%= @pokemon.pokedex_number.to_s.rjust(3, '0') %></p>
        <h2 class="select-pokemon-name"><%= @pokemon.name.capitalize %></h2>

        <div class="select-pokemon-difficulty">
          <span class="difficulty-label">Capture Difficulty:</span>
          <div class="difficulty-stars">
            <% @pokemon.difficulty.times do %>
              <span class="star-filled">★</span>
            <% end %>
            <% (5 - @pokemon.difficulty).times do %>
              <span class="star-empty">★</span>
            <% end %>
          </div>
          <span class="difficulty-text">
            <%= case @pokemon.difficulty
                when 1 then "Very Easy"
                when 2 then "Easy"
                when 3 then "Medium"
                when 4 then "Hard"
                when 5 then "Very Hard"
                end %>
          </span>
        </div>
      </div>
    </div>

    <!-- Pokeball Selection -->
    <h3 class="pokeball-selection-title">Select Your Pokéball</h3>

    <div class="pokeball-grid">
      <%= form_with url: catch_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "pokeball" %>
        <button type="submit" class="pokeball-card <%= 'pokeball-disabled' if @trainer.pokeballs_count == 0 %>" <%= "disabled" if @trainer.pokeballs_count == 0 %>>
          <div class="pokeball-card-icon"><%= image_tag "icons/pokeball_shop.png", alt: "Pokeball", class: "pokeball-icon-image" %></div>
          <div class="pokeball-card-content">
            <h4 class="pokeball-card-name">Pokéball</h4>
            <p class="pokeball-card-description">Standard Pokéball</p>
            <p class="pokeball-card-rate"><%= @catch_probabilities["pokeball"] %>% catch rate</p>
          </div>
          <div class="pokeball-card-count">
            <span class="pokeball-count-number"><%= @trainer.pokeballs_count %></span>
            <span class="pokeball-count-label">Available</span>
          </div>
        </button>
      <% end %>

      <%= form_with url: catch_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "great_ball" %>
        <button type="submit" class="pokeball-card <%= 'pokeball-disabled' if @trainer.great_balls_count == 0 %>" <%= "disabled" if @trainer.great_balls_count == 0 %>>
          <div class="pokeball-card-icon"><%= image_tag "icons/greatball.png", alt: "Great Ball", class: "pokeball-icon-image" %></div>
          <div class="pokeball-card-content">
            <h4 class="pokeball-card-name">Great Ball</h4>
            <p class="pokeball-card-description">Enhanced Pokéball</p>
            <p class="pokeball-card-rate"><%= @catch_probabilities["great_ball"] %>% catch rate</p>
          </div>
          <div class="pokeball-card-count">
            <span class="pokeball-count-number"><%= @trainer.great_balls_count %></span>
            <span class="pokeball-count-label">Available</span>
          </div>
        </button>
      <% end %>

      <%= form_with url: catch_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "ultra_ball" %>
        <button type="submit" class="pokeball-card <%= 'pokeball-disabled' if @trainer.ultra_balls_count == 0 %>" <%= "disabled" if @trainer.ultra_balls_count == 0 %>>
          <div class="pokeball-card-icon"><%= image_tag "icons/ultraball.jpg", alt: "Ultra Ball", class: "pokeball-icon-image" %></div>
          <div class="pokeball-card-content">
            <h4 class="pokeball-card-name">Ultra Ball</h4>
            <p class="pokeball-card-description">High-performance</p>
            <p class="pokeball-card-rate"><%= @catch_probabilities["ultra_ball"] %>% catch rate</p>
          </div>
          <div class="pokeball-card-count">
            <span class="pokeball-count-number"><%= @trainer.ultra_balls_count %></span>
            <span class="pokeball-count-label">Available</span>
          </div>
        </button>
      <% end %>

      <%= form_with url: catch_path(@pokemon), method: :post, local: true do |f| %>
        <%= f.hidden_field :ball_type, value: "master_ball" %>
        <button type="submit" class="pokeball-card <%= 'pokeball-disabled' if @trainer.master_balls_count == 0 %>" <%= "disabled" if @trainer.master_balls_count == 0 %>>
          <div class="pokeball-card-icon"><%= image_tag "icons/masterball.png", alt: "Master Ball", class: "pokeball-icon-image" %></div>
          <div class="pokeball-card-content">
            <h4 class="pokeball-card-name">Master Ball</h4>
            <p class="pokeball-card-description">Ultimate Pokéball</p>
            <p class="pokeball-card-rate"><%= @catch_probabilities["master_ball"] %>% catch rate</p>
          </div>
          <div class="pokeball-card-count">
            <span class="pokeball-count-number"><%= @trainer.master_balls_count %></span>
            <span class="pokeball-count-label">Available</span>
          </div>
        </button>
      <% end %>
    </div>

    <div style="text-align: center; margin-top: 32px;">
      <%= link_to "← Back to Pokémon List", catches_path, class: "link-secondary" %>
    </div>
  </main>
</div>
