<% available_pokemon = @route_available_pokemon[route.id] %>
<% available_by_type = @route_available_by_type[route.id] %>
<div class="route-card" data-route-id="<%= route.id %>">
  <div class="route-header">
    <h2 class="route-name"><%= route.name %></h2>
    <% if route.description.present? %>
      <p class="route-description"><%= route.description %></p>
    <% end %>
  </div>

  <!-- Encounter Type Selector -->
  <% has_grass = available_by_type[:grass].any? %>
  <% has_fish = available_by_type[:fish].any? && @has_fishing_rod %>
  <% has_surf = available_by_type[:surf].any? && @has_surf %>
  <% encounter_types_count = [has_grass, has_fish, has_surf].count(true) %>

  <% if encounter_types_count > 1 %>
    <div class="encounter-type-selector">
      <% if has_grass %>
        <button class="encounter-type-btn active" data-encounter-type="grass" data-route-id="<%= route.id %>">
          🌿 Land
        </button>
      <% end %>
      <% if has_surf %>
        <button class="encounter-type-btn <%= has_grass ? '' : 'active' %>" data-encounter-type="surf" data-route-id="<%= route.id %>">
          🌊 Surf
        </button>
      <% end %>
      <% if has_fish %>
        <button class="encounter-type-btn <%= (has_grass || has_surf) ? '' : 'active' %>" data-encounter-type="fish" data-route-id="<%= route.id %>">
          🎣 Fish
        </button>
      <% end %>
    </div>
  <% end %>

  <div class="route-pokemon">
    <h3 class="route-pokemon-title">Wild Pokémon:</h3>
    <div class="route-pokemon-list">
      <%
        # Only show encounters from types the trainer can access
        accessible_encounters = route.route_encounters.includes(:pokemon, :required_pokemon).select do |encounter|
          case encounter.encounter_type
          when "grass"
            true  # Grass is always accessible
          when "fish"
            @has_fishing_rod  # Only show fish if they have any fishing rod
          when "surf"
            @has_surf  # Only show surf if they have hm_surf
          else
            false
          end
        end

        accessible_encounters.sort_by { |e| e.pokemon.pokedex_number }.each do |encounter|
      %>
        <% pokemon = encounter.pokemon %>
        <% is_available = encounter.available_for?(@trainer) %>
        <% is_caught = @trainer.captured_pokemon.include?(pokemon) %>
        <div class="route-pokemon-item <%= is_caught ? 'caught' : '' %> <%= is_available ? '' : 'locked' %>"
             data-encounter-type="<%= encounter.encounter_type %>"
             data-route-id="<%= route.id %>">
          <%= image_tag "pokemonSprites/#{pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
              alt: pokemon.name,
              class: "route-pokemon-sprite",
              style: "image-rendering: pixelated; #{is_available ? '' : 'filter: brightness(0.4);'}" %>
          <div class="route-pokemon-info">
            <span class="route-pokemon-name"><%= pokemon.name %></span>
            <% if !is_available && encounter.requirement_description %>
              <span class="route-pokemon-requirement" style="font-size: 0.75rem; color: #888;">🔒 <%= encounter.requirement_description %></span>
            <% else %>
              <div class="route-pokemon-difficulty">
                <% pokemon.difficulty.times do %>
                  <span class="difficulty-star filled">★</span>
                <% end %>
                <% (5 - pokemon.difficulty).times do %>
                  <span class="difficulty-star empty">★</span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="route-actions">
    <% if available_pokemon.any? %>
      <% default_type = has_grass ? 'grass' : (has_surf ? 'surf' : 'fish') %>
      <%= form_with url: adventure_path(route), method: :post, class: "adventure-form", data: { route_id: route.id } do |f| %>
        <%= f.hidden_field :encounter_type, value: default_type, class: "encounter-type-input" %>
        <%= f.submit "Adventure", class: "btn-adventure" %>
      <% end %>
      <span class="route-available-count" data-route-id="<%= route.id %>">
        <% count = encounter_types_count > 1 ? available_by_type[default_type.to_sym].count : available_pokemon.count %>
        <%= count %> Pokémon available
      </span>
    <% else %>
      <button class="btn-adventure-disabled" disabled>All caught!</button>
    <% end %>
  </div>
</div>
