<% available_pokemon = @route_available_pokemon[route.id] %>
<div class="route-card" data-route-id="<%= route.id %>">
  <div class="route-header">
    <h2 class="route-name"><%= route.name %></h2>
    <% if route.description.present? %>
      <p class="route-description"><%= route.description %></p>
    <% end %>
  </div>

  <%
    # Determine which encounter types are available for this route
    has_grass_encounters = route.route_encounters.any? { |e| e.grass? }
    has_fish_encounters = route.route_encounters.any? { |e| e.fish? } && @has_any_fishing_rod
    has_surf_encounters = route.route_encounters.any? { |e| e.surf? } && @has_surf
    available_encounter_types = [has_grass_encounters, has_fish_encounters, has_surf_encounters].count(true)

    # Determine default active encounter type (priority: grass -> surf -> fish)
    # Surf takes priority over fish when no land encounters exist
    default_encounter_type = has_grass_encounters ? 'grass' : (has_surf_encounters ? 'surf' : 'fish')
  %>

  <!-- Encounter Type Selector (only show if 2+ types available) -->
  <% if available_encounter_types > 1 %>
    <div class="encounter-type-selector">
      <% if has_grass_encounters %>
        <button class="encounter-type-btn <%= default_encounter_type == 'grass' ? 'active' : '' %>" data-encounter-type="grass" data-route-id="<%= route.id %>">
          <%= image_tag "icons/grass.png", alt: "Grass", class: "encounter-type-icon" %>
          Land
        </button>
      <% end %>
      <% if has_fish_encounters %>
        <button class="encounter-type-btn <%= default_encounter_type == 'fish' ? 'active' : '' %>" data-encounter-type="fish" data-route-id="<%= route.id %>">
          <%= image_tag "icons/fishing.png", alt: "Fishing", class: "encounter-type-icon" %>
          Fish
        </button>
      <% end %>
      <% if has_surf_encounters %>
        <button class="encounter-type-btn <%= default_encounter_type == 'surf' ? 'active' : '' %>" data-encounter-type="surf" data-route-id="<%= route.id %>">
          <%= image_tag "icons/surfing.png", alt: "Surfing", class: "encounter-type-icon" %>
          Surf
        </button>
      <% end %>
    </div>
  <% end %>

  <!-- Rod Type Selector (only show when fish encounters exist and trainer has rods) -->
  <% if has_fish_encounters %>
    <%
      # Determine which rods the trainer has
      # Better rods give access to all lower-tier encounters
      best_rod = @has_super_rod ? 'super_rod' : (@has_good_rod ? 'good_rod' : 'old_rod')
    %>
    <div class="rod-selector" data-route-id="<%= route.id %>" style="<%= default_encounter_type == 'fish' ? '' : 'display: none;' %>">
      <% if @has_old_rod || @has_good_rod || @has_super_rod %>
        <button class="rod-btn <%= best_rod == 'old_rod' ? 'active' : '' %>" data-rod-type="old_rod" data-route-id="<%= route.id %>">
          <%= image_tag "icons/fishing.png", alt: "Fishing", class: "rod-icon" %>
          Old Rod
        </button>
      <% end %>
      <% if @has_good_rod || @has_super_rod %>
        <button class="rod-btn <%= best_rod == 'good_rod' ? 'active' : '' %>" data-rod-type="good_rod" data-route-id="<%= route.id %>">
          <%= image_tag "icons/fishing.png", alt: "Fishing", class: "rod-icon" %>
          Good Rod
        </button>
      <% end %>
      <% if @has_super_rod %>
        <button class="rod-btn <%= best_rod == 'super_rod' ? 'active' : '' %>" data-rod-type="super_rod" data-route-id="<%= route.id %>">
          <%= image_tag "icons/fishing.png", alt: "Fishing", class: "rod-icon" %>
          Super Rod
        </button>
      <% end %>
    </div>
  <% end %>

  <div class="route-pokemon">
    <h3 class="route-pokemon-title">Wild Pokémon:</h3>
    <div class="route-pokemon-list">
      <%
        # Helper method to determine if an encounter should be visible based on trainer's items
        def encounter_visible_for_trainer?(encounter, trainer_items)
          case encounter.encounter_type
          when "grass"
            # Land encounters are always visible
            true
          when "fish"
            # Fish encounters are visible if trainer has the required rod or better
            case encounter.required_item_key
            when "old_rod"
              trainer_items[:old_rod] || trainer_items[:good_rod] || trainer_items[:super_rod]
            when "good_rod"
              trainer_items[:good_rod] || trainer_items[:super_rod]
            when "super_rod"
              trainer_items[:super_rod]
            else
              false
            end
          when "surf"
            # Surf encounters are visible if trainer has hm_surf
            trainer_items[:surf]
          else
            false
          end
        end

        # Build trainer items hash
        trainer_items = {
          old_rod: @has_old_rod,
          good_rod: @has_good_rod,
          super_rod: @has_super_rod,
          surf: @has_surf
        }

        # Filter and display only visible encounters
        visible_encounters = route.route_encounters.includes(:pokemon, :required_pokemon).select do |encounter|
          encounter_visible_for_trainer?(encounter, trainer_items)
        end

        # Calculate appearance percentages for each encounter type
        # Group encounters by encounter type and rod requirement
        encounter_groups = visible_encounters.group_by do |e|
          if e.fish?
            "fish_#{e.required_item_key}"
          else
            e.encounter_type
          end
        end

        # Calculate percentage for each encounter in its group
        encounter_percentages = {}
        encounter_groups.each do |group_key, encounters|
          total_spawn_rate = encounters.sum(&:spawn_rate)
          encounters.each do |encounter|
            encounter_percentages[encounter.id] = ((encounter.spawn_rate.to_f / total_spawn_rate) * 100).round(1)
          end
        end

        visible_encounters.sort_by { |e| e.pokemon.pokedex_number }.each do |encounter|
      %>
        <% pokemon = encounter.pokemon %>
        <% is_available = encounter.available_for?(@trainer) %>
        <% is_caught = @trainer.captured_pokemon.include?(pokemon) %>
        <% appearance_percentage = encounter_percentages[encounter.id] %>
        <%
          # Initially hide Pokemon that don't match the default encounter type (unless only one type exists)
          should_hide_initially = available_encounter_types > 1 && encounter.encounter_type != default_encounter_type
          initial_display_style = should_hide_initially ? "display: none;" : ""
        %>
        <div class="route-pokemon-item <%= is_caught ? 'caught' : '' %> <%= is_available ? '' : 'locked' %>"
             data-encounter-type="<%= encounter.encounter_type %>"
             data-route-id="<%= route.id %>"
             <% if encounter.required_item_key.present? %>data-required-item="<%= encounter.required_item_key %>"<% end %>
             style="<%= initial_display_style %>">
          <%= image_tag "pokemonSprites/#{pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
              alt: pokemon.name,
              class: "route-pokemon-sprite",
              style: "image-rendering: pixelated; #{is_available ? '' : 'filter: brightness(0.4);'}" %>
          <div class="route-pokemon-info">
            <span class="route-pokemon-name"><%= pokemon.name %></span>
            <% if !is_available && encounter.requirement_description %>
              <span class="route-pokemon-requirement" style="font-size: 0.75rem; color: #888;">🔒 <%= encounter.requirement_description %></span>
            <% else %>
              <div class="route-pokemon-difficulty">
                <% pokemon.difficulty.times do %>
                  <span class="difficulty-star filled">★</span>
                <% end %>
                <% (5 - pokemon.difficulty).times do %>
                  <span class="difficulty-star empty">★</span>
                <% end %>
              </div>
              <span class="route-pokemon-percentage"><%= appearance_percentage %>%</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="route-actions">
    <%
      # Check if current encounter type has available Pokemon
      available_by_type = @route_available_by_type[route.id] || {}
      current_type_has_pokemon = available_by_type[default_encounter_type]

      # Check if ANY encounter type has available Pokemon
      any_type_has_pokemon = available_by_type.values.any?
    %>
    <% if available_pokemon.any? %>
      <% if @trainer.has_adventures? %>
        <!-- Always render adventure form if ANY encounter type has Pokemon (hide with CSS if current type locked) -->
        <%= form_with url: adventure_path(route),
                      method: :post,
                      class: "adventure-form",
                      data: { route_id: route.id },
                      html: { style: (current_type_has_pokemon ? '' : 'display: none;') } do |f| %>
          <%= f.hidden_field :encounter_type, value: default_encounter_type, class: "encounter-type-input" %>
          <%= f.hidden_field :rod_type, value: (has_fish_encounters ? best_rod : ''), class: "rod-type-input" %>
          <%= f.submit "Adventure", class: "btn-adventure" %>
        <% end %>

        <!-- Locked button for when current encounter type has no available Pokemon -->
        <button class="btn-adventure-disabled"
                disabled
                data-route-id="<%= route.id %>"
                style="<%= current_type_has_pokemon ? 'display: none;' : '' %>">
          Locked
        </button>

        <span class="route-available-count" style="<%= current_type_has_pokemon ? '' : 'display: none;' %>">
          <%
            # Show count of uncaught Pokemon
            uncaught_pokemon = available_pokemon.reject { |p| @trainer.captured_pokemon.include?(p) }
          %>
          <%= uncaught_pokemon.count %> Pokémon available
        </span>
      <% else %>
        <button class="btn-adventure-disabled" disabled>No More Adventures</button>
        <span class="route-available-count adventure-refresh-message">
          Replenishes in <%= @trainer.formatted_time_until_adventure %>
        </span>
      <% end %>
    <% else %>
      <%
        # Check if there are any locked Pokemon among visible encounters
        has_locked_pokemon = visible_encounters.any? { |encounter| !encounter.available_for?(@trainer) }
        button_text = has_locked_pokemon ? "Locked" : "All caught!"
      %>
      <button class="btn-adventure-disabled" disabled><%= button_text %></button>
    <% end %>
    <!-- Store encounter type availability as data attributes -->
    <div class="encounter-availability-data" data-route-id="<%= route.id %>" style="display: none;"
         data-grass-available="<%= available_by_type['grass'] %>"
         data-fish-available="<%= available_by_type['fish'] %>"
         data-surf-available="<%= available_by_type['surf'] %>">
    </div>
  </div>
</div>
