<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <h1>Adventure</h1>
      <p>Choose a route to explore and encounter wild Pokémon!</p>
    </header>

    <!-- Adventures Panel -->
    <% available = @trainer.available_adventures_to_claim %>
    <%
      # Calculate total adventures to restore (uncapped)
      if @trainer.adventures_allocated_at.nil?
        restore_amount = 5
      else
        time_elapsed = Time.current - @trainer.adventures_allocated_at
        full_periods_passed = (time_elapsed / 24.hours).floor
        restore_amount = full_periods_passed * 5
      end

      potions = [
        { key: 'potion', name: 'Potion', restore: 3 },
        { key: 'super_potion', name: 'Super Potion', restore: 6 },
        { key: 'hyper_potion', name: 'Hyper Potion', restore: 10 }
      ]
      has_potions = potions.any? { |p| @trainer.has_item?(p[:key], 1) }
    %>
    <div class="adventures-panel">
      <!-- Adventures Count -->
      <div class="adventures-section adventures-count-section">
        <span class="adventures-label">Adventures</span>
        <div class="adventures-count <%= 'adventures-depleted' if @trainer.adventures_remaining == 0 %>">
          <span class="adventures-count-number"><%= @trainer.adventures_remaining %></span>
          <span class="adventures-count-max">/ 10</span>
        </div>
      </div>

      <!-- Poké Center -->
      <div class="adventures-section pokecenter-section">
        <%= form_with url: visit_poke_center_path, method: :post, local: true, id: 'poke-center-form' do |f| %>
          <% if available > 0 %>
            <button type="submit" class="btn-poke-center">
              <%= image_tag "icons/pokecenter.png", alt: "Poké Center", class: "poke-center-icon" %>
              <span class="btn-text">
                <span class="btn-primary-text">Poké Center</span>
                <span class="btn-secondary-text">+<%= restore_amount %> Adventures</span>
              </span>
            </button>
          <% else %>
            <button type="submit" class="btn-poke-center-disabled" disabled>
              <%= image_tag "icons/pokecenter.png", alt: "Poké Center", class: "poke-center-icon" %>
              <span class="btn-text">
                <span class="btn-primary-text">Poké Center</span>
                <span class="btn-secondary-text"><%= @trainer.formatted_time_until_adventure %></span>
              </span>
            </button>
          <% end %>
        <% end %>
        <!-- Poké Center Audio (hidden) -->
        <audio id="poke-center-audio" src="/audio/pokecenter.mp3" preload="auto" data-enabled="<%= @trainer.play_pokecenter_audio %>"></audio>
      </div>

      <!-- Potions -->
      <% if has_potions %>
        <div class="adventures-section potions-section">
          <span class="adventures-label">Potions</span>
          <div class="potions-row">
            <% potions.each do |potion| %>
              <% if @trainer.has_item?(potion[:key], 1) %>
                <%= form_with url: use_potion_path, method: :post, local: true, class: 'potion-form', data: { potion_name: potion[:name], restore_amount: potion[:restore] } do |f| %>
                  <%= hidden_field_tag :potion_key, potion[:key] %>
                  <button type="submit" class="btn-potion" title="<%= potion[:name] %> (+<%= potion[:restore] %> adventures)">
                    <%= image_tag "icons/#{potion[:key]}.png", alt: potion[:name], class: "potion-icon" %>
                    <span class="potion-count"><%= @trainer.item_quantity(potion[:key]) %></span>
                  </button>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Potion Confirmation Modal -->
    <div id="potionConfirmationModal" class="modal" style="display: none;">
      <div class="modal-overlay"></div>
      <div class="modal-content">
        <h3 class="modal-title">Confirm Potion Use</h3>
        <p class="modal-message" id="potionConfirmationMessage">
          Use a <span id="potionName">Potion</span> to restore <span id="restoreAmount">3</span> adventures?
          <br><br>
          <strong>Any adventures restored beyond the maximum of 10 will be lost.</strong>
        </p>
        <div class="modal-actions">
          <button id="potionConfirmYes" class="btn-primary">Yes</button>
          <button id="potionConfirmNo" class="btn-secondary">No</button>
        </div>
      </div>
    </div>

    <!-- Gates and Routes -->
    <div class="adventure-container">
      <%
        # Badge mapping for gates 1-8 and Elite Four (gate 9)
        badge_map = {
          1 => { name: "Boulder Badge", sprite: "boulder_badge.png" },
          2 => { name: "Cascade Badge", sprite: "cascade_badge.png" },
          3 => { name: "Thunder Badge", sprite: "thunder_badge.png" },
          4 => { name: "Rainbow Badge", sprite: "rainbow_badge.png" },
          5 => { name: "Soul Badge", sprite: "soul_badge.png" },
          6 => { name: "Marsh Badge", sprite: "marsh_badge.png" },
          7 => { name: "Volcano Badge", sprite: "volcano_badge.png" },
          8 => { name: "Earth Badge", sprite: "earth_badge.png" },
          9 => { name: "Elite Four Trophy", sprite: "elite_four_trophy.png" }
        }
      %>
      <!-- Gates and their routes (newest first) %>
      <% @gates.each do |gate| %>
        <%# Skip gates beyond the next locked gate (in descending order, this means higher gate numbers) %>
        <% next if @next_locked_gate && gate.gate_number > @next_locked_gate.gate_number %>

        <% is_unlocked = @trainer.has_unlocked_gate?(gate) %>
        <% meets_requirement = gate.requirement_met_for?(@trainer) %>
        <% gate_routes = @gated_routes.select { |r| r.gate_requirement == gate.gate_number } %>

        <!-- For unlocked gates: show routes first, then gate -->
        <% if meets_requirement && gate_routes.any? %>
          <div class="gate-routes">
            <div class="routes-grid">
              <% gate_routes.each do |route| %>
                <%= render partial: 'route_card', locals: { route: route } %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Gate Card -->
        <div class="gate-card <%= meets_requirement ? 'unlocked' : 'locked' %>">
          <div class="gate-sprite">
            <% if gate.sprite_type == "emoji" %>
              <span class="gate-emoji"><%= gate.sprite_value %></span>
            <% elsif gate.sprite_type == "gym_leader" %>
              <%= image_tag "trainerSprites/gymLeaders/#{gate.sprite_value}.png",
                  alt: gate.name,
                  class: "gate-gym-leader-sprite" %>
            <% end %>
          </div>

          <div class="gate-info">
            <h2 class="gate-name">
              <%= gate.name %>
              <% if meets_requirement && badge_map[gate.gate_number] %>
                <%= image_tag "badges/#{badge_map[gate.gate_number][:sprite]}",
                              alt: badge_map[gate.gate_number][:name],
                              class: "gate-badge-icon",
                              title: badge_map[gate.gate_number][:name] %>
              <% end %>
            </h2>
            <p class="gate-description"><%= gate.description %></p>

            <!-- Progress Bar -->
            <div class="gate-progress">
              <div class="gate-progress-info">
                <span class="gate-progress-label">
                  <% if is_unlocked %>
                    Unlocked at score <%= gate.required_difficulty_score %>
                  <% else %>
                    Score required: <%= gate.required_difficulty_score %>
                  <% end %>
                </span>
                <span class="gate-progress-value">
                  <%= [@trainer.difficulty_score, gate.required_difficulty_score].min %> / <%= gate.required_difficulty_score %>
                </span>
              </div>
              <div class="gate-progress-bar">
                <%
                  if gate.required_difficulty_score == 0
                    progress_percentage = 100
                  else
                    progress_percentage = [(@trainer.difficulty_score.to_f / gate.required_difficulty_score * 100).round, 100].min
                  end
                %>
                <div class="gate-progress-fill <%= meets_requirement ? 'complete' : '' %>" style="width: <%= progress_percentage %>%"></div>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Always Accessible Routes (Pallet Town) - shown at the bottom -->
      <% if @always_accessible_routes.any? %>
        <div class="gate-routes">
          <div class="routes-grid">
            <% @always_accessible_routes.each do |route| %>
              <%= render partial: 'route_card', locals: { route: route } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </main>
</div>

<script>
  // Use turbo:load instead of DOMContentLoaded to handle Turbo navigation
  document.addEventListener('turbo:load', function() {
    console.log('=== Encounter selector initialized (turbo:load) ===');
    console.log('Current URL:', window.location.href);

    // Function to filter Pokemon for a specific route and encounter type
    function filterPokemonByEncounterType(routeId, encounterType) {
      console.log(`filterPokemonByEncounterType called: route=${routeId}, type=${encounterType}`);

      const allPokemon = document.querySelectorAll(`.route-pokemon-item[data-route-id="${routeId}"]`);
      console.log(`Found ${allPokemon.length} total Pokemon for route ${routeId}`);

      let visibleCount = 0;

      allPokemon.forEach(item => {
        const isMatchingType = item.dataset.encounterType === encounterType;
        const isLocked = item.classList.contains('locked');

        // Show if it matches the encounter type
        if (isMatchingType) {
          item.style.display = '';
          // Only count if not locked
          if (!isLocked) {
            visibleCount++;
          }
        } else {
          item.style.display = 'none';
        }
      });

      // Update available count
      const countSpan = document.querySelector(`.route-card[data-route-id="${routeId}"] .route-available-count`);
      if (countSpan) {
        countSpan.textContent = `${visibleCount} Pokémon available`;
        console.log(`Updated count to ${visibleCount}`);
      }

      console.log(`Route ${routeId}: Filtered to ${encounterType}, ${visibleCount} available`);
    }

    // Function to update Adventure button based on encounter type availability
    function updateAdventureButton(routeId, encounterType) {
      console.log(`updateAdventureButton called: route=${routeId}, type=${encounterType}`);

      // Get encounter availability data
      const availabilityData = document.querySelector(`.encounter-availability-data[data-route-id="${routeId}"]`);
      if (!availabilityData) {
        console.warn(`No availability data found for route ${routeId}`);
        return;
      }

      // Check if current encounter type has available Pokemon
      const isAvailable = availabilityData.dataset[`${encounterType}Available`] === 'true';
      console.log(`${encounterType} encounters available: ${isAvailable}`);

      // Find the route card's action area
      const routeCard = document.querySelector(`.route-card[data-route-id="${routeId}"]`);
      if (!routeCard) {
        console.warn(`No route card found for route ${routeId}`);
        return;
      }

      const routeActions = routeCard.querySelector('.route-actions');
      const adventureForm = routeActions.querySelector('.adventure-form');
      const lockedButton = routeActions.querySelector(`.btn-adventure-disabled[data-route-id="${routeId}"]`);

      if (isAvailable) {
        // Show adventure form if trainer has adventures
        if (adventureForm) {
          adventureForm.style.display = '';
          const countSpan = routeActions.querySelector('.route-available-count');
          if (countSpan) {
            countSpan.style.display = '';
          }
        }
        if (lockedButton) {
          lockedButton.style.display = 'none';
        }
      } else {
        // Show locked button
        if (adventureForm) {
          adventureForm.style.display = 'none';
          const countSpan = routeActions.querySelector('.route-available-count');
          if (countSpan) {
            countSpan.style.display = 'none';
          }
        }
        if (lockedButton) {
          lockedButton.style.display = '';
        }
      }

      console.log(`Updated adventure button for route ${routeId}: ${isAvailable ? 'enabled' : 'locked'}`);
    }

    // Find all encounter type buttons
    const allButtons = document.querySelectorAll('.encounter-type-btn');
    console.log(`Found ${allButtons.length} encounter type buttons on page`);

    // Handle encounter type button clicks
    allButtons.forEach((button, index) => {
      const encounterType = button.dataset.encounterType;
      const routeId = button.dataset.routeId;
      const isActive = button.classList.contains('active');

      console.log(`Button ${index}: type=${encounterType}, route=${routeId}, active=${isActive}`);

      button.addEventListener('click', function(e) {
        console.log(`=== BUTTON CLICKED ===`);
        console.log(`Type: ${this.dataset.encounterType}, Route: ${this.dataset.routeId}`);

        e.preventDefault();
        e.stopPropagation();

        const routeId = this.dataset.routeId;
        const encounterType = this.dataset.encounterType;

        // Update active state for buttons on this route
        const routeButtons = document.querySelectorAll(`.encounter-type-btn[data-route-id="${routeId}"]`);
        console.log(`Found ${routeButtons.length} buttons for this route`);

        routeButtons.forEach(btn => {
          btn.classList.remove('active');
        });
        this.classList.add('active');
        console.log(`Set ${encounterType} button to active`);

        // Update hidden input in form
        const form = document.querySelector(`.adventure-form[data-route-id="${routeId}"]`);
        if (form) {
          const input = form.querySelector('.encounter-type-input');
          if (input) {
            input.value = encounterType;
            console.log(`Updated form input to: ${encounterType}`);
          } else {
            console.warn('Could not find encounter-type-input in form');
          }
        } else {
          console.warn(`Could not find adventure-form for route ${routeId}`);
        }

        // Filter Pokemon list
        filterPokemonByEncounterType(routeId, encounterType);

        // Show/hide rod selector based on encounter type
        const rodSelector = document.querySelector(`.rod-selector[data-route-id="${routeId}"]`);
        if (rodSelector) {
          if (encounterType === 'fish') {
            rodSelector.style.display = 'flex';
            // Trigger filtering by active rod
            const activeRodBtn = rodSelector.querySelector('.rod-btn.active');
            if (activeRodBtn) {
              activeRodBtn.click();
            }
          } else {
            rodSelector.style.display = 'none';
          }
        }

        // Update Adventure button based on encounter type availability
        updateAdventureButton(routeId, encounterType);
      }, { passive: false });

      console.log(`✓ Attached click handler to button ${index}`);
    });

    // Handle rod type button clicks
    const allRodButtons = document.querySelectorAll('.rod-btn');
    console.log(`Found ${allRodButtons.length} rod buttons on page`);

    allRodButtons.forEach((button, index) => {
      const rodType = button.dataset.rodType;
      const routeId = button.dataset.routeId;
      const isActive = button.classList.contains('active');

      console.log(`Rod Button ${index}: type=${rodType}, route=${routeId}, active=${isActive}`);

      button.addEventListener('click', function(e) {
        console.log(`=== ROD BUTTON CLICKED ===`);
        console.log(`Rod Type: ${this.dataset.rodType}, Route: ${this.dataset.routeId}`);

        e.preventDefault();
        e.stopPropagation();

        const routeId = this.dataset.routeId;
        const rodType = this.dataset.rodType;

        // Update active state for rod buttons on this route
        const routeRodButtons = document.querySelectorAll(`.rod-btn[data-route-id="${routeId}"]`);
        console.log(`Found ${routeRodButtons.length} rod buttons for this route`);

        routeRodButtons.forEach(btn => {
          btn.classList.remove('active');
        });
        this.classList.add('active');
        console.log(`Set ${rodType} rod button to active`);

        // Update hidden input in form
        const form = document.querySelector(`.adventure-form[data-route-id="${routeId}"]`);
        if (form) {
          const input = form.querySelector('.rod-type-input');
          if (input) {
            input.value = rodType;
            console.log(`Updated rod_type input to: ${rodType}`);
          } else {
            console.warn('Could not find rod-type-input in form');
          }
        }

        // Filter fish Pokemon by rod type
        const allFishPokemon = document.querySelectorAll(`.route-pokemon-item[data-route-id="${routeId}"][data-encounter-type="fish"]`);
        let visibleCount = 0;

        // Exclusive rod selection: each rod shows only its own encounter table
        allFishPokemon.forEach(item => {
          const requiredItem = item.dataset.requiredItem;
          const isLocked = item.classList.contains('locked');
          const canCatch = requiredItem === rodType;

          if (canCatch) {
            item.style.display = '';
            if (!isLocked) {
              visibleCount++;
            }
          } else {
            item.style.display = 'none';
          }
        });

        console.log(`Filtered fish Pokemon: ${visibleCount} available for ${rodType}`);

        // Update available count
        const countSpan = document.querySelector(`.route-card[data-route-id="${routeId}"] .route-available-count`);
        if (countSpan) {
          countSpan.textContent = `${visibleCount} Pokémon available`;
        }
      }, { passive: false });

      console.log(`✓ Attached click handler to rod button ${index}`);
    });

    // Initialize: Filter Pokemon on page load based on active button
    const selectors = document.querySelectorAll('.encounter-type-selector');
    console.log(`Found ${selectors.length} encounter type selectors`);

    selectors.forEach((selector, index) => {
      const activeBtn = selector.querySelector('.encounter-type-btn.active');
      if (activeBtn) {
        const routeId = activeBtn.dataset.routeId;
        const encounterType = activeBtn.dataset.encounterType;
        console.log(`Selector ${index}: Initializing route ${routeId} with ${encounterType}`);

        // Run filtering directly instead of clicking
        filterPokemonByEncounterType(routeId, encounterType);
      } else {
        console.warn(`Selector ${index}: No active button found`);
      }
    });

    console.log('=== Initialization complete ===');
  });

  // Potion confirmation modal
  document.addEventListener('turbo:load', function() {
    const modal = document.getElementById('potionConfirmationModal');
    const confirmYes = document.getElementById('potionConfirmYes');
    const confirmNo = document.getElementById('potionConfirmNo');
    const potionNameSpan = document.getElementById('potionName');
    const restoreAmountSpan = document.getElementById('restoreAmount');
    let pendingForm = null;

    // Handle potion form submissions
    document.querySelectorAll('.potion-form').forEach(form => {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        const potionName = this.dataset.potionName;
        const restoreAmount = this.dataset.restoreAmount;

        potionNameSpan.textContent = potionName;
        restoreAmountSpan.textContent = restoreAmount;
        pendingForm = this;
        modal.style.display = 'flex';
      });
    });

    // Handle Yes button
    confirmYes.addEventListener('click', function() {
      if (pendingForm) {
        modal.style.display = 'none';
        // Submit the form natively (not via Turbo)
        const nativeForm = pendingForm.cloneNode(true);
        nativeForm.removeAttribute('data-turbo');
        document.body.appendChild(nativeForm);
        nativeForm.submit();
      }
    });

    // Handle No button
    confirmNo.addEventListener('click', function() {
      modal.style.display = 'none';
      pendingForm = null;
    });

    // Close modal on overlay click
    if (modal) {
      const overlay = modal.querySelector('.modal-overlay');
      if (overlay) {
        overlay.addEventListener('click', function() {
          modal.style.display = 'none';
          pendingForm = null;
        });
      }
    }
  });

  // Poké Center audio
  document.addEventListener('turbo:load', function() {
    const pokeCenterForm = document.getElementById('poke-center-form');
    const pokeCenterAudio = document.getElementById('poke-center-audio');
    let audioPlaying = false;

    if (pokeCenterForm && pokeCenterAudio) {
      pokeCenterForm.addEventListener('submit', function(e) {
        // Check if audio is enabled in user settings
        const audioEnabled = pokeCenterAudio.dataset.enabled === 'true';

        // Only play if button is enabled (not disabled)
        const submitButton = this.querySelector('button[type="submit"]:not(:disabled)');

        if (submitButton && !audioPlaying && audioEnabled) {
          e.preventDefault(); // Prevent form submission
          audioPlaying = true;

          // Change button to loading state
          const originalHTML = submitButton.innerHTML;
          submitButton.disabled = true;
          submitButton.innerHTML = `
            <svg class="spinner" style="width: 24px; height: 24px; animation: spin 1s linear infinite; display: inline-block; vertical-align: middle;" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" opacity="0.25"></circle>
              <path d="M12 2a10 10 0 0 1 10 10" opacity="0.75"></path>
            </svg>
            <span style="margin-left: 8px;">Restoring...</span>
          `;

          // Add spinner animation
          if (!document.getElementById('spinner-style')) {
            const style = document.createElement('style');
            style.id = 'spinner-style';
            style.textContent = '@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }';
            document.head.appendChild(style);
          }

          // Play the audio and wait for it to finish
          pokeCenterAudio.currentTime = 0; // Reset to start

          const submitFormAfterAudio = () => {
            console.log('Audio finished, submitting form');
            audioPlaying = false;
            pokeCenterForm.submit();
          };

          // Listen for audio to finish
          pokeCenterAudio.onended = submitFormAfterAudio;

          // Start playing
          pokeCenterAudio.play()
            .then(() => {
              console.log('✓ Poké Center audio playing');
            })
            .catch(err => {
              console.error('✗ Audio playback failed:', err);
              // Submit anyway if audio fails
              audioPlaying = false;
              submitButton.disabled = false;
              submitButton.innerHTML = originalHTML;
              pokeCenterForm.submit();
            });
        }
        // If audio is disabled, form submits normally (no e.preventDefault())
      });
    }
  });
</script>

