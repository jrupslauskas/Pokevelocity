<div class="app-layout">
  <%= render "trainers/sidebar" %>

  <main class="main-content">
    <header class="page-header-authenticated">
      <h1>Catch Pokémon</h1>
      <p>Choose a Pokémon to attempt to catch.</p>
    </header>

    <!-- Stats Bar -->
    <div class="catch-stats-bar">
      <div class="catch-stat">
        <span class="catch-stat-label">Caught</span>
        <span class="catch-stat-value"><%= @trainer.captures.count %> / 151</span>
      </div>
      <div class="catch-stat">
        <span class="catch-stat-label">Available</span>
        <span class="catch-stat-value"><%= @uncaught_pokemon.count %></span>
      </div>
      <div class="catch-stat">
        <span class="catch-stat-label">Pokéballs</span>
        <span class="catch-stat-value"><%= @trainer.total_pokeballs %></span>
      </div>
    </div>

    <% if @uncaught_pokemon.any? %>
      <div class="pokemon-catch-grid">
        <% @uncaught_pokemon.each do |pokemon| %>
          <div class="pokemon-catch-card">
            <div class="pokemon-catch-image">
              <% if pokemon.image.attached? %>
                <%= image_tag pokemon.image, alt: pokemon.name %>
              <% else %>
                <%= image_tag "pokemonSprites/#{pokemon.pokedex_number.to_s.rjust(3, '0')}.png",
                    alt: pokemon.name,
                    style: "image-rendering: pixelated;" %>
              <% end %>
            </div>

            <div class="pokemon-catch-info">
              <p class="pokemon-catch-number">#<%= pokemon.pokedex_number.to_s.rjust(3, '0') %></p>
              <h3 class="pokemon-catch-name"><%= pokemon.name %></h3>

              <div class="pokemon-catch-difficulty">
                <span class="difficulty-label">Difficulty:</span>
                <div class="difficulty-stars">
                  <% pokemon.difficulty.times do %>
                    <span class="star-filled">★</span>
                  <% end %>
                  <% (5 - pokemon.difficulty).times do %>
                    <span class="star-empty">★</span>
                  <% end %>
                </div>
              </div>

              <div class="pokemon-catch-trainers">
                <span class="trainers-label">Caught by <%= @pokemon_trainer_counts[pokemon.id] || 0 %>/<%= @total_trainers %> trainers</span>
              </div>
            </div>

            <%= link_to "Catch", catch_path(pokemon), class: "btn-catch" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-icon">🎉</div>
        <h3 class="empty-state-title">Congratulations!</h3>
        <p class="empty-state-description">You've caught all 151 Pokémon!</p>
        <%= link_to "View Pokédex", pokedex_path, class: "btn-primary" %>
      </div>
    <% end %>
  </main>
</div>
